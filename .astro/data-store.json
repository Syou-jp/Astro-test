[["Map",1,2,7,8,152,153],"meta::meta",["Map",3,4,5,6],"astro-version","4.16.19","config-digest","8c53a2a1d3af1657","newsDigests",["Map",9,10,39,40,72,73,97,98,125,126],"2026-07-20",{"id":9,"data":11,"filePath":35,"digest":36,"rendered":37},{"date":12,"tag":13,"coverImage":14,"coverAlt":15,"title":16,"teaser":17,"sources":18,"sections":19},"2026年7月20日（月・祝）","社会","/news/2026-07-20.jpg","北海道富良野市の国道で発生した正面衝突事故の現場","富良野市で外国人運転のレンタカーが正面衝突、香港人女性が死亡・6人重軽傷","3連休最終日の2026年7月20日午後、北海道富良野市の国道38号線で、外国人が運転するレンタカーが対向車線にはみ出しSUVと正面衝突。両車の計6人が重軽傷を負い、レンタカーに同乗していた香港籍の53歳女性が翌日死亡しました。","UHB北海道文化放送（2026年7月20日）、STV札幌テレビ（2026年7月21日）、HTB北海道テレビ（2026年7月21日）、FNNプライムオンライン 事故報道速報（2026年7月20日）",[20,25,30],{"h":21,"p":22},"国道38号線でレンタカーとSUVが正面衝突、6人搬送",[23,24],"2026年7月20日午後3時30分ごろ、北海道富良野市学田三区の国道38号線で、香港から訪れていた家族4人（50代男性、50代女性、10代女性2人）が乗車するレンタカーが対向車線にはみ出し、対向してきたSUVと正面衝突しました。","SUVには日本人の20代男女2人が乗車しており、両車に乗っていた計6人が重軽傷を負い、ドクターヘリなどで病院へ搬送されました。現場は3連休最終日で観光客の利用が多い主要ルートでした。",{"h":26,"p":27},"同乗の香港籍女性、搬送後に死亡確認",[28,29],"搬送された6人のうち、レンタカーの助手席に乗っていた53歳の香港籍女性は事故直後は意識があったものの、搬送後に容体が急変し、翌7月21日に死亡が確認されました。","他の同乗者や対向車のSUVに乗っていた男女2人も重軽傷を負っており、警察が事故の詳しい原因を調べています。",{"h":31,"p":32},"観光地で相次ぐ外国人ドライバーの事故、標識多言語化の議論に拍車",[33,34],"富良野市周辺は夏の観光シーズンで多くの外国人観光客がレンタカーを利用するルートとして知られています。近年、北海道などの観光地では外国人ドライバーによる逆走や標識見落としに起因する事故が相次いでおり、今回の事故はその一例となりました。","今回の事故を受け、道路標識の多言語化（英語表記「STOP」の導入など）や、レンタカー利用時の安全対策強化を求める議論がさらに加速する見通しです。","src/data/news-digests/2026-07-20.md","3a24f7a1d9399e39",{"html":38},"","2026-07-21",{"id":39,"data":41,"filePath":69,"digest":70,"rendered":71},{"date":42,"tag":13,"coverImage":43,"coverAlt":44,"title":45,"teaser":46,"sources":47,"sections":48},"2026年7月21日（火）","/news/2026-07-21.jpg","外国人関連ニュースのイメージ","訪日客のレンタカー事故対策を本格化、外国人材受入れと共生に向けた動き相次ぐ","国土交通省と観光庁が訪日外国人のレンタカー事故防止対策を主要空港周辺で先行実施するほか、育成就労制度への移行セミナー開催、外国人向け生活支援企業の大型資金調達、政府の外国人受入・共生策の議論など、外国人関連の動きが相次ぎました。","トラベルボイス（Travel Voice）／国土交通省・観光庁 報道発表（2026年7月21日）、PR TIMES 日本計画研究所 JPI プレスリリース（2026年7月21日）、GTN プレスリリース（2026年7月21日）、出入国在留管理庁 報道発表資料、日本経済新聞",[49,54,59,64],{"h":50,"p":51},"国土交通省・観光庁、訪日外国人のレンタカー事故防止対策を本格化",[52,53],"国土交通省道路局と観光庁は2026年7月21日、インバウンド（訪日外国人客）によるレンタカー事故の増加を受け、主要空港周辺における交通安全対策を本格的に展開すると発表しました。右折時の事故発生率が日本人ドライバーの約2.7倍に上ることを受け、まずは新千歳・福岡・那覇の3空港周辺地域で先行実施します。","多言語ナビの機能強化や道路標識の改善などを進める方針で、観光客の利用が多い主要ルートでの安全対策強化が期待されています。",{"h":55,"p":56},"在留外国人・労働者数が過去最高、「育成就労制度」移行セミナー開催",[57,58],"2026年7月21日、弁護士法人Global HR Strategyの杉田昌平弁護士を講師に迎え、「育成就労制度への転換で変わる外国人材受入れ実務」に関するビジネスセミナーが開催されました。在留外国人が過去最多の376万人、外国人労働者が230万人を突破する中、従来の技能実習制度から「育成就労」への移行に伴う企業側の実務対応が論じられました。","セミナーでは特定技能の活用戦略や、共生社会に向けた課題についても議論が交わされました。",{"h":60,"p":61},"在留外国人向け支援サービスGTN、約30億円規模の資金調達を実施",[62,63],"在留外国人向けに住まいや生活インフラ支援を展開する株式会社グローバルトラストネットワークス（GTN）は2026年7月21日、総取引規模約30億円の資金調達ラウンドを実施したと発表しました。","増加する在留外国人や外国人材の生活基盤・定着支援事業をさらに拡大・強化する狙いがあります。",{"h":65,"p":66},"政府、外国人材の受入・共生に向けた環境整備実施計画を改定へ",[67,68],"政府の「外国人材の受入・共生に関する関係閣僚会議」において、外国人の適正な在留管理と生活支援を両立させるための環境整備方針が議論されました。永住許可要件の厳格化（一定以上の所得要件や厚生年金加入期間など）が盛り込まれています。","地方自治体と連携した多言語相談窓口の機能強化や、在留カードとマイナンバーカードの一体化運用の推進も検討されています。","src/data/news-digests/2026-07-21.md","a96b88564b877944",{"html":38},"2026-07-22",{"id":72,"data":74,"filePath":94,"digest":95,"rendered":96},{"date":75,"tag":13,"coverImage":76,"coverAlt":44,"title":77,"teaser":78,"sources":79,"sections":80},"2026年7月22日（水）","/news/2026-07-22.jpg","訪日客消費額2.5兆円、民泊禁止条例の導入、在留外国人向け日本語学習サービス発表","観光庁の調査で2026年4〜6月期の訪日外国人消費額が推計2.5兆円に達したことが分かりました。政府は自治体が民泊を制限・禁止できる条例導入を後押しする通知を行い、在留外国人向けの多言語日本語学習サービスも新たに発表されました。","FNNプライムオンライン（2026年7月22日配信）、自由民主党 機関紙「自由民主」（2026年7月22日掲載）、PR TIMES（2026年7月22日発表）",[81,86,90],{"h":82,"p":83},"訪日外国人観光客の消費額調査（4〜6月期：推計2.5兆円）",[84,85],"観光庁は、2026年4月〜6月期の「インバウンド消費動向調査」を発表しました。訪日外国人による日本国内での総消費額は推計2兆5,096億円を記録しました。","1人当たりの消費額トップはメキシコで50万円を超えました。",{"h":87,"p":88},"自治体による「民泊禁止・制限条例」制定の通知",[89],"訪日外国人の利用が拡大する一方でマナー低下や近隣トラブルが懸念される民泊に対し、自治体が条例によって営業制限や全面禁止（ゼロ日規制）を導入できるよう、政府・観光庁が自治体向け通知を行った方針が報じられました。",{"h":91,"p":92},"在留外国人向け多言語日本語学習サービスが新発表",[93],"教育ICT事業を展開するチエル株式会社が、国内に居住・就労する在留外国人を対象とした多言語対応の日本語学習サービス『ABLish® 日本へGO！』を2026年10月に新発売することを発表しました。","src/data/news-digests/2026-07-22.md","33a8c1a1134cc9fb",{"html":38},"2026-07-23",{"id":97,"data":99,"filePath":122,"digest":123,"rendered":124},{"date":100,"tag":13,"coverImage":101,"coverAlt":102,"title":103,"teaser":104,"sources":105,"sections":106},"2026年7月23日（木）","/news/2026-07-23.jpg","夜の繁華街で入国警備官が外国人住民に声をかけている様子","退職自衛官を「入国警備官」に、訪日客2,108万人、高校生向け多文化共生講座","在留外国人数が2025年末に400万人を突破したことを受け、政府は不法残留の取り締まり強化に乗り出します。訪日外国人数は2026年前半で2,108万人に達し、明治大学は高校生向けの多文化共生サマースクールを発表しました。","日本政府・出入国在留管理庁 発表資料（2026年7月23日）、日本政府観光局（JNTO）訪日外客数統計（2026年7月23日公表）、明治大学 ニュースリリース（2026年7月23日）",[107,112,117],{"h":108,"p":109},"不法残留取り締まり強化：退職自衛官を「入国警備官」に起用へ",[110,111],"在留外国人数が2025年末に初めて400万人を突破し、法執行の現場で人手不足が深刻化していることを受け、日本政府は2026年7月23日、不法残留外国人の摘発や送還業務を強化するため、退職自衛官を「入国警備官」として採用・登用する方針を明らかにしました。","政府は出入国在留管理庁の職員を200人以上増員する計画で、そのうち約50人の警備官を不法就労などが懸念される茨城県などの地域に重点配置する見込みです。",{"h":113,"p":114},"2026年前半の訪日外国人客数、2,100万人を突破",[115,116],"2026年1月〜6月の訪日外国人旅行者数は2,108万人に達したことが公表されました。中国からの訪日客が政策の影響で大きく減少したため、全体の訪日客数は5年ぶりに前年同期比でわずかに減少（2%減）しました。","一方で、韓国（568万人、前年同期比18.6%増）や台湾（397万人、同20.9%増）からの観光客が大幅に増加し、日本のインバウンド市場を支えています。",{"h":118,"p":119},"多文化共生の推進：高校生向け「やさしい日本語」サマースクール",[120,121],"地域社会における外国人住民との共生を目的とした取り組みも進んでいます。明治大学は2026年7月23日、高校生を対象とした「多文化共生サマースクール」の開催を発表しました。","外国人にも伝わりやすい「やさしい日本語」の活用や国際交流ワークショップを通じて、外国人住民と共生できる豊かな社会づくりを目指します。","src/data/news-digests/2026-07-23.md","652c466825456afa",{"html":38},"2026-07-24",{"id":125,"data":127,"filePath":149,"digest":150,"rendered":151},{"date":128,"tag":13,"coverImage":129,"coverAlt":44,"title":130,"teaser":131,"sources":132,"sections":133},"2026年7月24日（金）","/news/2026-07-24.jpg","在留外国人受入れの数値目標を検討する有識者会議設置、永住許可要件も厳格化へ","政府は在留外国人の受入れのあり方を議論する有識者会議の新設を決定し、来年3月に基本方針をまとめる方針です。併せて永住許可要件の厳格化も進められ、マイナビグローバルの調査では在留外国人の96%が「今後も日本で働きたい」と回答しました。","読売新聞、FNNプライムオンライン、観光経済新聞／マイナビグローバル",[134,139,144],{"h":135,"p":136},"「特定技能」など在留外国人受入れ、数値目標検討の有識者会議設置を決定",[137,138],"政府は2026年7月24日、外国人政策に関する関係閣僚会議を開き、在留外国人の受入れのあり方を検討する有識者会議の新設を決定しました。受入れ人数に数値目標を設けるかどうかなどを議論し、来年3月に基本方針をまとめる予定です。","木原官房長官は小野田経済安保大臣に対し、基本的なあり方の議論と将来設計を進めるよう指示しました。",{"h":140,"p":141},"外国人の永住許可要件を厳格化、「日本人の平均上回る年収水準」新指針に明記へ",[142,143],"政府は外国人政策関係閣僚会議に合わせ、外国人の永住許可要件の厳格化方針を固めました。新たに「日本人世帯の平均収入を上回る水準の継続」や「厚生年金30年加入相当の年金受給見込み額（不足時は金融資産補填）」などの基準を新指針に明記します。","年収要件は10月、その他の要件は来年4月からの適用を目指しています。",{"h":145,"p":146},"マイナビグローバル調査、96%が「今後も日本で働きたい」と回答",[147,148],"マイナビグローバルが発表した日本在留外国人を対象とした就労意欲調査によると、「今後も日本で働きたい」と答えた割合は前年比3.5ポイント増の95.8%となりました。","一方で「5年以上働きたい」とする回答は14.7ポイント減の61.6%となり、円安や母国の賃金上昇を背景に、長期的には他国（韓国など）への関心を示す傾向もみられました。","src/data/news-digests/2026-07-24.md","45ade17ab0c430a9",{"html":38},"restaurants",["Map",154,155,186,187,206,207,223,224,255,256,273,274,291,292,304,305,321,322,338,339,355,356,372,373,389,390,407,408,424,425,441,442,458,459,474,475,490,491,505,506,522,523,537,538,551,552,567,568,583,584,597,598,609,610,627,628,639,640,655,656,667,668,684,685,706,707,722,723,739,740,756,757,773,774,790,791,818,819],"amatru-hair-omotesando",{"id":154,"data":156,"filePath":183,"digest":184,"rendered":185},{"name":157,"type":158,"country":159,"region":160,"area":161,"category":162,"description":163,"mapQuery":164,"mapUrl":165,"claimed":166,"logo":167,"flag":168,"officialName":169,"intro":170,"signatureDishes":171,"photos":172,"priceRange":176,"languages":177,"payment":178,"instagram":181,"line":182},"AMATRU HAIR","beauty","台湾","東京","表参道","美容室","台湾人に人気の表参道ヘアサロン。日本語不要、中国語通訳対応で安心して施術を受けられます。","東京都渋谷区神宮前4-14-18 表参道J-FLAT 1F","https://www.google.com/maps/place/AMATRU+HAIR+%E8%A1%A8%E5%8F%82%E9%81%93/@28.1607645,145.0282385,3a,75y,90t/data=!3m8!1e2!3m6!1sCIABIhC9W7Too56R-q_5HsicE2jk!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fgps-cs-s%2FAHRPTWkWU3cIroxEALQblEnc677HJKKHEMdifZIgNKbRzA_wlTwvhflLhxeDY2IRk8KPYxLhYSJ-8-yNzvXuuh_UN5-bV4ZmwVOAoZuva1ybNdVagzr1XlFJnk9bqRQyEgmOjEW4oeOtKld6cKjL%3Dw203-h270-k-no!7i3024!8i4032!4m7!3m6!1s0x89f0f237c6122939:0x3f7c9ed9bee66d7c!8m2!3d28.1607645!4d145.0282385!10e5!16s%2Fg%2F11zbcz8w81",true,"/experts/amatru-hair-icon.jpg","🇯🇵","SALOWIN 表参道 FLAT店","表参道駅A2出口（Apple隣の出口）から徒歩約3分