---
export function getStaticPaths() {
  return [{ params: { locale: 'ja' } }];
}

const { locale = 'ja' } = Astro.params;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sotocom 投稿</title>
  </head>
  <body>
    <main class="liff-shell" id="liff-app" hidden>
      <header class="liff-header">
        <p class="liff-kicker">SOTOCOM COMMUNITY</p>
        <h1 id="page-title">投稿する</h1>
        <p id="page-intro">LINEから投稿内容を送信できます。確認後に掲載します。</p>
      </header>

      <form id="community-form" novalidate>
        <div id="dynamic-fields"></div>
        <section class="photo-uploader" aria-labelledby="photo-title">
          <div class="photo-uploader-head"><div><p class="photo-eyebrow">OPTIONAL</p><h2 id="photo-title">写真を追加</h2></div><span>最大8枚</span></div>
          <p class="photo-help">写真は審査が完了するまで非公開です。先頭の写真が一覧カードの主画像になります。</p>
          <input id="photo-input" type="file" accept="image/*" multiple />
          <div id="photo-list" class="photo-list" aria-live="polite"></div>
        </section>
        <label>表示名 <em>必須</em><input name="displayName" type="text" placeholder="サイトに表示する名前" required /></label>
        <label class="agreement"><input name="agreement" type="checkbox" required /><span>投稿内容が確認後に公開されることに同意します。</span></label>
        <button type="submit" id="submit-button">投稿内容を送信する</button>
        <p class="form-status" id="form-status" aria-live="polite"></p>
      </form>
    </main>

    <section class="liff-error" id="liff-error" hidden>
      <p class="liff-kicker">SOTOCOM COMMUNITY</p>
      <h1>LINEから開いてください</h1>
      <p>この投稿フォームは、Sotocom LINE公式アカウントの投稿メニューからのみ利用できます。</p>
    </section>

    <script>
      const LIFF_ID = '2011054732-exitzB6m';
      const API_URL = 'https://sotocom-api.syouboc.workers.dev/api/submissions';
      const OFFICIAL_ACCOUNT_URL = 'https://line.me/R/ti/p/%40721khrrb';
      const configs = {
        listings: { title: '入居募集を投稿する', intro: '物件カードに必要な情報を順番に入力してください。確認後、掲載用に整えます。', fields: [['listingType', '募集タイプ', '', 'select', [['tenant', 'オーナー直貸し'], ['share', 'ルームシェア募集']]], ['title', '募集タイトル', '例：駅から徒歩5分の1LDK', 'text'], ['prefecture', '都道府県', '', 'select', [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']]], ['area', '区・市町村', '', 'select', []], ['station', '最寄り駅', '例：中野駅 徒歩5分', 'text'], ['rent', '家賃（月額・円）', '例：90000', 'number'], ['managementFee', '管理費（月額・円）', '例：5000', 'number'], ['layout', '間取り・広さ', '', 'select', []], ['moveIn', '入居可能時期', '', 'select', []], ['furnished', '家具・家電', '', 'select', [['あり', '家具・家電付き'], ['一部', '一部あり'], ['なし', 'なし']]], ['details', '条件・補足', '初期費用、契約期間、性別条件、同居人など', 'textarea']] },
        'used-market': { title: '中古市場に投稿する', intro: '中古市場のカードに必要な商品情報を入力してください。写真は後から追加できます。', fields: [['category', 'カテゴリー', '', 'select', [['furniture', '家具'], ['appliance', '家電・ガジェット'], ['daily-goods', '生活雑貨・キッチン'], ['fashion', 'ファッション・美容'], ['kids', '子供用品・おもちゃ'], ['hobby', '本・趣味・スポーツ'], ['other', 'その他']]], ['title', '商品名', '例：冷蔵庫（168L）', 'text'], ['condition', '商品の状態', '', 'select', [['new', '新品・未使用'], ['good', '目立つ傷なし'], ['used', '使用感あり'], ['repair', '要確認・難あり']]], ['price', '価格（円）', '無料の場合は0', 'number'], ['prefecture', '受け渡し都道府県', '', 'select', [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']]], ['pickupArea', '受け渡し場所', '例：中野駅・杉並区', 'text'], ['availableUntil', '受け渡し可能日', '', 'select', []], ['delivery', '受け渡し方法', '', 'select', [['pickup', '現地受け取り'], ['station', '駅で受け渡し'], ['delivery', '配送相談'], ['other', 'その他']]], ['details', '商品説明', '購入時期、サイズ、動作確認、傷、付属品など', 'textarea']] },
        jobs: { title: '求人を投稿する', intro: '求人カードに必要な募集条件を入力してください。応募者が比較しやすい形に整えます。', fields: [['jobCategory', '職種カテゴリー', '', 'select', [['hotel', 'ホテル・宿泊'], ['restaurant', '飲食'], ['cleaning', '清掃'], ['office', '事務・オフィス'], ['care', '介護・福祉'], ['other', 'その他']]], ['title', '募集職種', '例：ホテルフロントスタッフ', 'text'], ['company', '会社・店舗名', '掲載名として表示します', 'text'], ['employmentType', '雇用形態', '', 'select', [['part-time', 'アルバイト・パート'], ['full-time', '正社員'], ['contract', '契約社員'], ['freelance', '業務委託'], ['other', 'その他']]], ['workplace', '勤務地', '', 'select', []], ['salary', '給与・報酬', '例：時給1,300円〜／月給25万円〜', 'text'], ['hours', '勤務時間', '', 'select', []], ['japaneseLevel', '日本語レベル', '', 'select', [['none', '不問'], ['basic', '日常会話'], ['business', 'ビジネスレベル'], ['native', 'ネイティブ相当']]], ['benefits', '待遇・条件', '交通費、まかない、寮、資格、経験など', 'textarea'], ['application', '応募方法', '担当者、連絡先、応募時に伝える内容など', 'textarea']] },
        events: { title: 'イベントを投稿する', intro: 'イベントページに表示する開催情報と参加方法を入力してください。', fields: [['eventCategory', 'イベントカテゴリー', '', 'select', [['exchange', '交流会・言語交換'], ['culture', '文化・コミュニティ'], ['workshop', '講座・ワークショップ'], ['market', 'マーケット・フェス'], ['other', 'その他']]], ['title', 'イベント名', '例：多文化交流会', 'text'], ['date', '開催日', '例：2026年9月1日', 'text'], ['startTime', '開始時刻', '例：18:00', 'time'], ['endTime', '終了時刻', '例：20:00', 'time'], ['venue', '会場名', '例：渋谷カフェアリス', 'text'], ['area', '開催エリア', '例：渋谷区・渋谷駅徒歩5分', 'text'], ['summary', '紹介文', 'カードに表示する短い紹介（1〜2文）', 'textarea'], ['fee', '参加費', '', 'select', []], ['capacity', '定員', '', 'select', []], ['participationType', '参加方法', '', 'select', []], ['participation', '申込方法・URL', '予約URL、問い合わせ先など', 'textarea'], ['notes', '注意事項', '雨天時、対象年齢、持ち物など', 'textarea']] },
        help: { title: '助け合いを投稿する', intro: '助けを求める人と協力できる人が判断しやすい情報を入力してください。', fields: [['category', '依頼カテゴリー', '', 'select', [['translate', '通訳・翻訳'], ['pet', 'ペット・留守番'], ['labor', '力仕事・引越し'], ['other', 'その他']]], ['title', '投稿タイトル', '例：引っ越しを手伝ってくれる方を探しています', 'text'], ['requestDate', '希望日時', '', 'select', []], ['area', '場所', '例：杉並区・高円寺エリア', 'text'], ['reward', '謝礼', '', 'select', []], ['urgent', '急募', '', 'select', [['no', '通常'], ['yes', '急募']]], ['details', '依頼内容', 'いつ、どこで、何を手伝ってほしいかを具体的に書いてください', 'textarea'], ['contact', '連絡方法', 'LINE ID、メール、その他の希望連絡方法', 'text']] }
      };
      const params = new URLSearchParams(location.search);
      const type = params.get('type') || 'events';
      const config = configs[type] || configs.events;
      const app = document.querySelector('#liff-app');
      const error = document.querySelector('#liff-error');
      const status = document.querySelector('#form-status');
      const form = document.querySelector('#community-form');
      const fields = document.querySelector('#dynamic-fields');
      document.querySelector('#page-title').textContent = config.title;
      document.querySelector('#page-intro').textContent = config.intro;
      fields.innerHTML = config.fields.map(([name, label, placeholder, kind]) => `<label>${label} <em>必須</em>${kind === 'textarea' ? `<textarea name="${name}" rows="6" placeholder="${placeholder}" required></textarea>` : `<input name="${name}" type="${kind}" placeholder="${placeholder}" required />`}</label>`).join('');

      const photoInput = document.querySelector('#photo-input');
      const photoList = document.querySelector('#photo-list');
      const photoFiles = [];
      function renderPhotos() { photoList.innerHTML = photoFiles.map((file, index) => `<article class="photo-item"><img src="${URL.createObjectURL(file)}" alt="選択した写真 ${index + 1}"><div><b>${index === 0 ? '一覧の主画像' : `写真 ${index + 1}`}</b><div class="photo-actions"><button type="button" data-photo-up="${index}" ${index === 0 ? 'disabled' : ''}>←前へ</button><button type="button" data-photo-down="${index}" ${index === photoFiles.length - 1 ? 'disabled' : ''}>次へ→</button><button type="button" data-photo-remove="${index}">削除</button></div></div></article>`).join(''); }
      photoInput.addEventListener('change', () => { const incoming = Array.from(photoInput.files || []).filter((file) => file.type.startsWith('image/')); photoFiles.push(...incoming.slice(0, Math.max(0, 8 - photoFiles.length))); photoInput.value = ''; renderPhotos(); });
      photoList.addEventListener('click', (event) => { const button = event.target.closest('button'); if (!button) return; const index = Number(button.dataset.photoUp ?? button.dataset.photoDown ?? button.dataset.photoRemove); if (button.dataset.photoRemove !== undefined) photoFiles.splice(index, 1); if (button.dataset.photoUp !== undefined && index > 0) [photoFiles[index - 1], photoFiles[index]] = [photoFiles[index], photoFiles[index - 1]]; if (button.dataset.photoDown !== undefined && index < photoFiles.length - 1) [photoFiles[index + 1], photoFiles[index]] = [photoFiles[index], photoFiles[index + 1]]; renderPhotos(); });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        event.stopImmediatePropagation();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const liff = await loadLiff;
        const idToken = liff.getIDToken();
        if (!idToken) { status.textContent = 'LINE認証を確認できませんでした。'; status.classList.add('visible'); return; }
        status.textContent = '写真と投稿内容を送信中…'; status.classList.add('visible');
        const values = Object.fromEntries(new FormData(form).entries());
        delete values.agreement; delete values.displayName; delete values.photos;
        const upload = new FormData();
        upload.append('submission', JSON.stringify({ type, displayName: String(form.elements.displayName.value), payload: values }));
        photoFiles.forEach((file) => upload.append('photos', file, file.name));
        try {
          const response = await fetch(API_URL, { method: 'POST', headers: { authorization: `Bearer ${idToken}` }, body: upload });
          if (!response.ok) throw new Error('submission-failed');
          status.textContent = '投稿を受け付けました。写真を含めて確認後に掲載します。'; form.reset(); photoFiles.length = 0; renderPhotos();
        } catch { status.textContent = '送信に失敗しました。時間を置いて再度お試しください。'; }
      }, true);

      const selectOptions = {
        listingType: [['tenant', 'オーナー直貸し'], ['share', 'ルームシェア募集']],
        prefecture: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']],
        area: type === 'listings' ? [['新宿区', '新宿区'], ['渋谷区', '渋谷区'], ['中野区', '中野区'], ['杉並区', '杉並区'], ['世田谷区', '世田谷区'], ['豊島区', '豊島区'], ['港区', '港区'], ['台東区', '台東区'], ['その他', 'その他']] : [],
        layout: [['1R', '1R'], ['1K', '1K'], ['1DK', '1DK'], ['1LDK', '1LDK'], ['2DK', '2DK'], ['2LDK', '2LDK'], ['3LDK以上', '3LDK以上'], ['その他', 'その他']],
        moveIn: [['immediate', '即入居可'], ['next-month', '翌月から'], ['相談', '時期相談'], ['other', 'その他']],
        furnished: [['あり', '家具・家電付き'], ['一部', '一部あり'], ['なし', 'なし']],
        category: type === 'help' ? [['translate', '通訳・翻訳'], ['pet', 'ペット・留守番'], ['labor', '力仕事・引越し'], ['other', 'その他']] : [['furniture', '家具'], ['appliance', '家電・ガジェット'], ['daily-goods', '生活雑貨・キッチン'], ['fashion', 'ファッション・美容'], ['kids', '子供用品・おもちゃ'], ['hobby', '本・趣味・スポーツ'], ['other', 'その他']],
        condition: [['new', '新品・未使用'], ['good', '目立つ傷なし'], ['used', '使用感あり'], ['repair', '要確認・難あり']],
        delivery: [['pickup', '現地受け取り'], ['station', '駅で受け渡し'], ['delivery', '配送相談'], ['other', 'その他']],
        availableUntil: [['anytime', '日程相談可'], ['this-week', '今週中'], ['this-month', '今月中'], ['date', '指定日まで'], ['other', 'その他']],
        jobCategory: [['hotel', 'ホテル・宿泊'], ['restaurant', '飲食'], ['cleaning', '清掃'], ['office', '事務・オフィス'], ['care', '介護・福祉'], ['other', 'その他']],
        employmentType: [['part-time', 'アルバイト・パート'], ['full-time', '正社員'], ['contract', '契約社員'], ['freelance', '業務委託'], ['other', 'その他']],
        workplace: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['群馬県', '群馬県'], ['その他', 'その他']],
        hours: [['day', '日中（9:00〜18:00前後）'], ['morning', '早朝・午前'], ['evening', '夕方・夜'], ['shift', 'シフト制'], ['flexible', '応相談']],
        japaneseLevel: [['none', '不問'], ['basic', '日常会話'], ['business', 'ビジネスレベル'], ['native', 'ネイティブ相当']],
        eventCategory: [['exchange', '交流会・言語交換'], ['culture', '文化・コミュニティ'], ['workshop', '講座・ワークショップ'], ['market', 'マーケット・フェス'], ['other', 'その他']],
        fee: [['free', '無料'], ['paid', '有料'], ['donation', '投げ銭・任意'], ['reservation', '要問い合わせ']],
        capacity: [['small', '10名未満'], ['medium', '10〜30名'], ['large', '30名以上'], ['unlimited', '定員なし'], ['unknown', '未定']],
        participationType: [['reservation', '事前予約'], ['walk-in', '当日参加'], ['both', '予約・当日参加'], ['contact', '主催者へ問い合わせ']],
        requestDate: [['today', 'できるだけ早く'], ['this-week', '今週中'], ['this-month', '今月中'], ['flexible', '日程相談可'], ['other', '指定日あり']],
        reward: [['paid', '謝礼あり'], ['consult', '応相談'], ['none', '無償'], ['exchange', '物品・サービス交換']],
        urgent: [['no', '通常'], ['yes', '急募']],
      };
      Object.entries(selectOptions).forEach(([name, options]) => { const old = fields.querySelector(`[name="${name}"]`); if (!old || !options.length) return; const select = document.createElement('select'); select.name = name; select.required = true; select.innerHTML = `<option value="">選択してください</option>${options.map(([value, text]) => `<option value="${value}">${text}</option>`).join('')}`; old.replaceWith(select); });

      const loadLiff = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://static.line-scdn.net/liff/edge/2/sdk.js';
        script.onload = () => resolve(window.liff);
        script.onerror = reject;
        document.head.appendChild(script);
      });

      async function boot() {
        try {
          const liff = await loadLiff;
          await liff.init({ liffId: LIFF_ID });
          if (!liff.isInClient()) throw new Error('not-in-line');
          if (!liff.isLoggedIn()) { liff.login(); return; }
          app.hidden = false;
        } catch (e) {
          error.hidden = false;
        }
      }
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const liff = await loadLiff;
        const idToken = liff.getIDToken();
        if (!idToken) { status.textContent = 'LINEの認証を確認できませんでした。'; status.classList.add('visible'); return; }
        status.textContent = 'LINE認証を確認しました。投稿送信APIの接続後に正式受付となります。';
        status.classList.add('visible');
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const liff = await loadLiff;
        const idToken = liff.getIDToken();
        if (!idToken) { status.textContent = 'LINE認証を確認できませんでした。'; status.classList.add('visible'); return; }
        status.textContent = '送信中…';
        status.classList.add('visible');
        const data = Object.fromEntries(new FormData(form).entries());
        delete data.agreement;
        delete data.displayName;
        try {
          const response = await fetch(API_URL, {
            method: 'POST',
            headers: { 'content-type': 'application/json', authorization: `Bearer ${idToken}` },
            body: JSON.stringify({ type, displayName: String(form.elements.displayName.value), payload: data }),
          });
          if (!response.ok) throw new Error('submission-failed');
          status.textContent = '投稿を受け付けました。確認後に掲載します。';
          form.reset();
        } catch {
          status.textContent = '送信に失敗しました。時間を置いて再度お試しください。';
        }
      });
      boot();
    </script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box} :global(html),:global(body){margin:0;min-height:100%;background:#f4f6f8;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP",sans-serif} :global(body){padding:0}
  .liff-shell,.liff-error{width:min(100%,620px);min-height:100vh;margin:0 auto;padding:28px 20px 40px;background:#fff}.liff-error{display:grid;place-content:center;min-height:100vh;text-align:center}.liff-error[hidden],.liff-shell[hidden]{display:none}.liff-header{padding:8px 0 24px;border-bottom:1px solid #e1e6ec}.liff-kicker{margin:0 0 8px;color:#1e5b82;font:700 10px/1.2 ui-monospace,monospace;letter-spacing:.14em}.liff-header h1,.liff-error h1{margin:0;font-size:26px;line-height:1.45;letter-spacing:.02em}.liff-header p:last-child,.liff-error p:last-child{margin:9px 0 0;color:#64748b;font-size:13px;line-height:1.8}#community-form{padding-top:22px}label{display:grid;gap:7px;margin:0 0 18px;color:#253248;font-size:13px;font-weight:700}em{color:#b4533c;font-size:10px;font-style:normal;margin-left:4px}input:not([type=checkbox]),textarea{width:100%;padding:13px 14px;border:1px solid #d7dee7;border-radius:10px;background:#fbfcfd;color:#172033;font:inherit;font-size:14px;font-weight:400;outline:none}textarea{resize:vertical;line-height:1.75}input:focus,textarea:focus{border-color:#1e5b82;box-shadow:0 0 0 3px #1e5b8220}.agreement{display:flex;grid-template-columns:none;align-items:flex-start;gap:8px;color:#64748b;font-size:12px;font-weight:400;line-height:1.7}.agreement input{margin-top:4px;accent-color:#1e5b82}button{width:100%;padding:15px 18px;border:0;border-radius:10px;background:#1e5b82;color:#fff;font:700 14px inherit;cursor:pointer}button:active{transform:translateY(1px)}.form-status{display:none;margin:14px 0 0;color:#26704b;font-size:12px;line-height:1.7}.form-status.visible{display:block}
</style>

<style>
  :global(body){background:#e9eef0;color:#173044;letter-spacing:.01em}
  .liff-shell{position:relative;width:min(100%,680px);padding:0 22px 42px;background:#f9fbfa;box-shadow:0 18px 60px #17304418}
  .liff-header{margin:0 -22px 0;padding:34px 22px 28px;background:#173044;color:#f9fbfa;border:0;border-radius:0 0 28px 28px;position:relative;overflow:hidden}
  .liff-header:after{content:"";position:absolute;width:180px;height:180px;right:-56px;top:-74px;border:1px solid #b8d86a66;border-radius:50%;box-shadow:0 0 0 16px #b8d86a12,0 0 0 34px #b8d86a08}
  .liff-kicker{position:relative;z-index:1;margin:0 0 18px;color:#b8d86a;font-size:10px;letter-spacing:.18em}
  .liff-header h1{position:relative;z-index:1;margin:0;max-width:520px;font-size:30px;line-height:1.3;letter-spacing:-.035em}
  .liff-header p:last-child{position:relative;z-index:1;max-width:520px;margin:13px 0 0;color:#d7e2e5;font-size:13px;line-height:1.85}
  #community-form{padding-top:26px}
  #dynamic-fields{display:grid;gap:14px}
