          if (!response.ok) throw new Error('submission-failed');
          status.textContent = '投稿を受け付けました。写真を含めて確認後に掲載します。'; form.reset(); customDisplayName.hidden = true; customDisplayName.disabled = true; photoFiles.length = 0; renderPhotos();
        } catch { status.textContent = '送信に失敗しました。時間を置いて再度お試しください。'; }
      }, true);

      const selectOptions = {
        listingType: [['tenant', 'オーナー直貸し'], ['share', 'ルームシェア募集']],
        prefecture: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']],
        layout: [['1R', '1R'], ['1K', '1K'], ['1DK', '1DK'], ['1LDK', '1LDK'], ['2K', '2K'], ['2DK', '2DK'], ['2LDK', '2LDK'], ['3K', '3K'], ['3DK', '3DK'], ['3LDK', '3LDK'], ['4K', '4K'], ['4DK', '4DK'], ['4LDK', '4LDK'], ['5K', '5K'], ['5DK', '5DK'], ['5LDK', '5LDK'], ['その他', 'その他']],
        moveIn: [['immediate', '即入居可'], ['consult', '相談'], ['date', '日付を選択']],
        contractPeriod: [['1m', '1ヶ月以上'], ['3m', '3ヶ月以上'], ['6m', '半年以上'], ['1y', '1年以上'], ['2y', '2年'], ['consult', '相談']],
        furnished: [['あり', '家具・家電付き'], ['一部', '一部あり'], ['なし', 'なし']],
        depositMonths: [['none', 'なし'], ['0.5', '0.5ヶ月'], ['1', '1ヶ月'], ['1.5', '1.5ヶ月'], ['2', '2ヶ月'], ['3', '3ヶ月']],
        keyMoneyMonths: [['none', 'なし'], ['0.5', '0.5ヶ月'], ['1', '1ヶ月'], ['1.5', '1.5ヶ月'], ['2', '2ヶ月'], ['3', '3ヶ月']],
        pet: [['ok', '可（相談）'], ['ng', '不可']],
        genderRestriction: [['none', 'なし'], ['male', '男性限定'], ['female', '女性限定']],
        tenantNationalityHasCondition: [['none', 'なし'], ['yes', 'あり']],
        category: type === 'help' ? [['translate', '通訳・翻訳'], ['pet', 'ペット・留守番'], ['labor', '力仕事・引越し'], ['other', 'その他']] : [['furniture', '家具'], ['appliance', '家電・ガジェット'], ['daily-goods', '生活雑貨・キッチン'], ['fashion', 'ファッション・美容'], ['kids', '子供用品・おもちゃ'], ['hobby', '本・趣味・スポーツ'], ['other', 'その他']],
        condition: [['new', '新品・未使用'], ['good', '目立つ傷なし'], ['used', '使用感あり'], ['repair', '要確認・難あり']],
        delivery: [['pickup', '現地受け取り'], ['station', '駅で受け渡し'], ['delivery', '配送相談'], ['other', 'その他']],
        availableUntil: [['anytime', '日程相談可'], ['this-week', '今週中'], ['this-month', '今月中'], ['date', '指定日まで'], ['other', 'その他']],
        jobCategory: [['hotel', 'ホテル・宿泊'], ['restaurant', '飲食'], ['cleaning', '清掃'], ['office', '事務・オフィス'], ['care', '介護・福祉'], ['other', 'その他']],
        employmentType: [['part-time', 'アルバイト・パート'], ['full-time', '正社員'], ['contract', '契約社員'], ['freelance', '業務委託'], ['other', 'その他']],
        workplace: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['群馬県', '群馬県'], ['その他', 'その他']],
        hours: [['day', '日中（9:00〜18:00前後）'], ['morning', '早朝・午前'], ['evening', '夕方・夜'], ['shift', 'シフト制'], ['flexible', '応相談']],
        japaneseLevel: [['none', '不問'], ['basic', '日常会話'], ['business', 'ビジネスレベル'], ['native', 'ネイティブ相当']],
        eventPrefecture: ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'].map((name) => [name, name]),
        fee: [['free', '無料'], ['paid', '有料']],
        feeAmount: [['500', '500円'], ['1000', '1,000円'], ['1500', '1,500円'], ['2000', '2,000円'], ['3000', '3,000円'], ['5000', '5,000円'], ['10000', '10,000円'], ['other', 'その他（「その他」に記入）']],
        capacity: [['small', '10名未満'], ['medium', '10〜30名'], ['large', '30名以上'], ['unlimited', '定員なし'], ['unknown', '未定']],
        participationType: [['reservation', '事前予約'], ['walk-in', '当日参加'], ['both', '予約・当日参加'], ['contact', '主催者へ問い合わせ']],
        requestDate: [['today', 'できるだけ早く'], ['this-week', '今週中'], ['this-month', '今月中'], ['flexible', '日程相談可'], ['other', '指定日あり']],
        reward: [['paid', '謝礼あり'], ['consult', '応相談'], ['none', '無償'], ['exchange', '物品・サービス交換']],
        urgent: [['no', '通常'], ['yes', '急募']],
      };
      Object.entries(selectOptions).forEach(([name, options]) => {
        if (type === 'listings' && (name === 'area' || name === 'station')) return;
        const old = fields.querySelector(`[name="${name}"]`);
        if (!old || !options.length) return;
        const select = document.createElement('select');
        select.name = name;
        select.required = true;
        select.innerHTML = `<option value="">選択してください</option>${options.map(([value, text]) => `<option value="${value}">${text}</option>`).join('')}`;
        if (options.length > 4) {
          old.replaceWith(select);
          return;
        }
        const oldField = old.closest('label');
        const fieldLabel = oldField.querySelector('.field-label').innerHTML;
        const selectId = `choice-${name}`;
        select.id = selectId;
        select.className = 'choice-native';
        const choiceField = document.createElement('div');
        choiceField.className = 'choice-field';
        choiceField.innerHTML = `<label class="field-label" for="${selectId}">${fieldLabel}</label><div class="choice-options" data-count="${options.length}" role="group" aria-label="${oldField.querySelector('.field-label').textContent.trim()}">${options.map(([value, text]) => `<button type="button" class="choice-option" data-choice-value="${value}" aria-pressed="false">${text}</button>`).join('')}</div>`;
        choiceField.querySelector('.field-label').after(select);
        choiceField.querySelectorAll('.choice-option').forEach((button) => button.addEventListener('click', () => {
          select.value = button.dataset.choiceValue;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }));
        select.addEventListener('change', () => {
          choiceField.classList.remove('is-invalid');
          choiceField.querySelectorAll('.choice-option').forEach((button) => {
            const selected = button.dataset.choiceValue === select.value;
            button.classList.toggle('is-selected', selected);
            button.setAttribute('aria-pressed', String(selected));
          });
        });
        select.addEventListener('invalid', () => choiceField.classList.add('is-invalid'));
        oldField.replaceWith(choiceField);
      });
      form.addEventListener('reset', () => window.setTimeout(() => {
        fields.querySelectorAll('.choice-native').forEach((select) => select.dispatchEvent(new Event('change')));
      }, 0));
      const feeSelect = fields.querySelector('[name="fee"]');
      const feeAmountSelect = fields.querySelector('[name="feeAmount"]');
      const feeAmountField = feeAmountSelect?.closest('label');
      function syncFeeAmount() {
        if (!feeAmountSelect || !feeAmountField) return;
        const isPaid = feeSelect?.value === 'paid';
        feeAmountField.hidden = !isPaid;
        feeAmountSelect.disabled = !isPaid;
        feeAmountSelect.required = isPaid;
        if (!isPaid) feeAmountSelect.value = '';
      }
      feeSelect?.addEventListener('change', syncFeeAmount);
      syncFeeAmount();

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
      }
      function optionLabel(name, value) {
        if (!value) return '';
        const match = (selectOptions[name] || []).find(([optionValue]) => optionValue === value);
        return escapeHtml(match ? match[1] : value);
      }
      function previewAvatarSrc() {
        const useLineAvatar = form.elements.publishAvatarMode.value === 'line';
        return useLineAvatar
          ? (lineProfileAvatar.dataset.lineAvatarUrl || LINE_AVATAR_PLACEHOLDER_URL)
          : (selectedAvatarUrl.value || '/images/avatars/avatar-01.webp');
      }
      function previewPhotoSrc(index) {
        return photoFiles[index] ? URL.createObjectURL(photoFiles[index]) : '';
      }
      function yen(value) {
        const number = Number(String(value ?? '').replace(/[^0-9.]/g, ''));
        return Number.isFinite(number) && String(value ?? '').trim() !== '' ? `${number.toLocaleString('ja-JP')}円` : '';
      }
      function formatDateTime(value) {
        if (!value) return '';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return escapeHtml(value);
        return date.toLocaleString('ja-JP', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      }

      function listingAutoTitle(values) {
        const place = [values.prefecture, values.area].filter(Boolean).join(' ');
        return [place, values.layout].filter(Boolean).join(' ・ ') || '入居募集';
      }

      function buildListingsPreview(values) {
        const badgeIsTenant = values.listingType !== 'share';
        const photo = previewPhotoSrc(0);
        const address = [values.prefecture, values.area, values.station].filter(Boolean).map(escapeHtml).join(' ');
        const priceParts = [yen(values.rent)];
        if (values.managementFee && Number(values.managementFee) > 0) priceParts.push(`＋管理費${yen(values.managementFee)}`);
        const card = `<article class="pv-card pv-listings"><div class="pv-card-image">${photo ? `<img src="${photo}" alt="">` : '<span>写真準備中</span>'}<span class="pv-badge ${badgeIsTenant ? 'pv-badge-tenant' : 'pv-badge-share'}">${badgeIsTenant ? 'オーナー直貸し' : 'ルームシェア募集'}</span></div><div class="pv-card-body"><h3>${escapeHtml(listingAutoTitle(values))}</h3><div class="pv-meta-line">${address ? `📍 ${address}` : '（場所未入力）'}</div><div class="pv-price">${priceParts.filter(Boolean).join(' ') || '（家賃未入力）'}</div><div class="pv-footer"><span>更新：たった今</span><span class="pv-author"><img src="${previewAvatarSrc()}" alt=""><span>${escapeHtml(getPublishDisplayName())}</span><span class="pv-flag">${lineNationalityFlag.textContent}</span></span></div></div></article>`;
        return card;
      }

      function buildUsedMarketPreview(values) {
        const photo = previewPhotoSrc(0);
        const price = Number(values.price) === 0 ? '無料' : yen(values.price);
        const card = `<article class="pv-card pv-used-market"><div class="pv-card-image">${photo ? `<img src="${photo}" alt="">` : '<span>写真準備中</span>'}</div><div class="pv-card-body"><h3>${escapeHtml(values.title) || '（商品名未入力）'}</h3><div class="pv-price pv-price-um">${price || '（価格未入力）'}</div><div class="pv-meta-rows"><div><b>受け渡し</b><span>${optionLabel('delivery', values.delivery) || '未設定'}</span></div><div><b>場所</b><span>${escapeHtml([values.prefecture, values.pickupArea].filter(Boolean).join(' ')) || '未設定'}</span></div></div></div></article>`;
        return card;
      }

      function buildJobsPreview(values) {
        const metaLine = [escapeHtml(values.company), escapeHtml(values.workplace), escapeHtml(values.salary)].filter(Boolean).join('｜');
        const tags = [optionLabel('jobCategory', values.jobCategory), optionLabel('employmentType', values.employmentType), optionLabel('japaneseLevel', values.japaneseLevel)].filter(Boolean);
        const card = `<article class="pv-card pv-jobs"><div class="pv-card-body"><h3>${escapeHtml(values.title) || '（募集職種未入力）'}</h3><div class="pv-meta-line">${metaLine || '（会社・勤務地・給与未入力）'}</div><p class="pv-desc">${escapeHtml(values.benefits) || ''}</p><div class="pv-tags">${tags.map((tag) => `<span class="pv-tag">${tag}</span>`).join('')}</div></div></article>`;
        return card;
      }

      function buildEventsPreview(values) {
        const dateRange = [formatDateTime(values.startsAt), formatDateTime(values.endsAt)].filter(Boolean).join('〜');
        const card = `<article class="pv-card pv-events"><div class="pv-card-body"><h3>${escapeHtml(values.title) || '（タイトル未入力）'}</h3><p class="pv-desc">${escapeHtml(values.summary) || ''}</p><div class="pv-meta-rows"><div><b>日時</b><span>${dateRange || '未設定'}</span></div><div><b>場所</b><span>${escapeHtml(values.venue) || '未設定'}</span></div></div></div></article>`;
        return card;
      }

      function buildHelpPreview(values) {
        const urgent = values.urgent === 'yes';
        const card = `<article class="pv-card pv-help"><div class="pv-card-body"><div class="pv-title-row"><h3>${escapeHtml(values.title) || '（タイトル未入力）'}</h3>${urgent ? '<span class="pv-urgent">急募</span>' : ''}</div><div class="pv-meta-rows"><div><b>タイプ</b><span>${optionLabel('category', values.category) || '未設定'}</span></div><div><b>日時</b><span>${optionLabel('requestDate', values.requestDate) || '未設定'}</span></div><div><b>場所</b><span>${escapeHtml(values.area) || '未設定'}</span></div><div><b>謝礼</b><span>${optionLabel('reward', values.reward) || '未設定'}</span></div></div></div></article>`;
        return card;
      }

      const previewBuilders = { listings: buildListingsPreview, 'used-market': buildUsedMarketPreview, jobs: buildJobsPreview, events: buildEventsPreview, help: buildHelpPreview };

      function buildPreviewDetail(values) {
        let rows = Array.from(fields.querySelectorAll('input[name], textarea[name], select[name]'))
          .filter((el) => !el.disabled && el.name !== 'title' && el.name !== 'conditionChecks' && (el.type === 'checkbox' ? el.checked : el.value))
          .map((el) => {
            const labelHost = el.closest('label') || el.closest('.choice-field');
            const labelText = (labelHost?.querySelector('.field-label')?.textContent || labelHost?.querySelector('span')?.textContent || el.name).replace(/\*$/, '').trim();
            let displayValue;
            if (el.type === 'checkbox') {
              displayValue = '可';
            } else if (el.tagName === 'SELECT') {
              displayValue = escapeHtml(el.options[el.selectedIndex]?.text || el.value);
            } else {
              displayValue = escapeHtml(el.value);
            }
            return `<div class="pv-detail-item"><dt>${escapeHtml(labelText)}</dt><dd>${displayValue.replace(/\n/g, '<br>')}</dd></div>`;
          })
          .join('');
        const conditionChecksLabels = { fireInsurance: '火災保険加入必要', utilities: '光熱費割り勘', quiet: '静かな環境を優先', 'non-smoker': '禁煙' };
        const conditionChecksValues = Array.from(fields.querySelectorAll('[name="conditionChecks"]:checked')).map(c => conditionChecksLabels[c.value] || c.value);
        if (conditionChecksValues.length > 0) {
          rows += `<div class="pv-detail-item"><dt>条件備註</dt><dd>${escapeHtml(conditionChecksValues.join('・'))}</dd></div>`;
        }
        const photosHtml = photoFiles.length
          ? `<div class="pv-detail-photos">${photoFiles.map((_, index) => `<img src="${previewPhotoSrc(index)}" alt="写真${index + 1}">`).join('')}</div>`
          : '';
        const authorHtml = type === 'listings'
          ? `<div class="pv-detail-author"><img src="${previewAvatarSrc()}" alt=""><span>${escapeHtml(getPublishDisplayName())}</span><span class="pv-flag">${lineNationalityFlag.textContent}</span></div>`
          : '';
        const heading = type === 'listings' ? listingAutoTitle(values) : (escapeHtml(values.title) || '（タイトル未入力）');
        return `<article class="pv-detail-card">${photosHtml}<h2>${heading}</h2>${authorHtml}<div class="pv-detail-grid">${rows || '<p class="pv-detail-empty">入力された項目がここに表示されます。</p>'}</div></article>`;
      }

      const previewOverlay = document.querySelector('#preview-overlay');
      const previewCardSlot = document.querySelector('#preview-card-slot');
      const previewDetailSlot = document.querySelector('#preview-detail-slot');
      function openPreview() {
        const values = Object.fromEntries(new FormData(form).entries());
        const builder = previewBuilders[type] || buildEventsPreview;
        previewCardSlot.innerHTML = `<div class="pv-card-frame pv-theme-${type}">${builder(values)}</div>`;
        previewDetailSlot.innerHTML = `<div class="pv-theme-${type}">${buildPreviewDetail(values)}</div>`;
        previewOverlay.hidden = false;
        app.setAttribute('aria-hidden', 'true');
      }
      function closePreview() {
        previewOverlay.hidden = true;
        app.removeAttribute('aria-hidden');
      }
      document.querySelector('#preview-button').addEventListener('click', openPreview);
      document.querySelector('#preview-overlay-close').addEventListener('click', closePreview);

      const loadLiff = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://static.line-scdn.net/liff/edge/2/sdk.js';
        script.onload = () => resolve(window.liff);
        script.onerror = reject;
        document.head.appendChild(script);
      });

      profileForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!profileForm.checkValidity()) { profileForm.reportValidity(); return; }
        const saveButton = document.querySelector('#profile-save-button');
        saveButton.disabled = true;
        profileStatus.textContent = '保存しています…';
        profileStatus.classList.add('visible');
        try {
          const liff = await loadLiff;
          const idToken = liff.getIDToken();
          const values = Object.fromEntries(new FormData(profileForm).entries());
          if (languageMode) delete values.nationalityCode;
          const response = await fetch(API_URL.replace('/api/submissions', '/api/profile'), { method: 'POST', headers: { authorization: `Bearer ${idToken}`, 'content-type': 'application/json' }, body: JSON.stringify(values) });
          if (!response.ok) {
            const detail = await response.json().catch(() => null);
            throw new Error(detail?.error || `profile-save-failed-${response.status}`);
          }
          profileStatus.textContent = '設定を保存しました。LINEに戻って投稿できます。';
          if (liff.isInClient()) window.setTimeout(() => liff.closeWindow(), 1000);
        } catch (error) {
          const message = error instanceof Error ? error.message : '';
          profileStatus.textContent = message === 'nationality_required' ? '国籍を選択してください。' : message === 'invalid_profile_options' ? '言語または国籍をもう一度選択してください。' : `保存できませんでした。もう一度お試しください。${message ? ` (${message})` : ''}`;
          saveButton.disabled = false;
        }
      });

      async function boot() {
        try {
          const liff = await loadLiff;
          await liff.init({ liffId: LIFF_ID });
          if (!liff.isInClient()) throw new Error('not-in-line');
          if (!liff.isLoggedIn()) { liff.login(); return; }
          try {
            const profile = await liff.getProfile();
            profileDisplayName = profile.displayName || '';
            if (profile.pictureUrl) { lineProfileAvatar.dataset.lineAvatarUrl = profile.pictureUrl; lineAvatarChoice.src = profile.pictureUrl; }
            updateDisplayNamePreview();
          } catch {
            updateDisplayNamePreview();
          }
          try {
            const idToken = liff.getIDToken();
            const response = await fetch(API_URL.replace('/api/submissions', '/api/profile'), { headers: { authorization: `Bearer ${idToken}` } });
            const result = response.ok ? await response.json() : null;
            const code = result?.profile?.nationality_code;
            if (code && code !== 'OTHER') lineNationalityFlag.textContent = code.replace(/./g, (char) => String.fromCodePoint(127397 + char.charCodeAt(0)));
            if (profileMode || languageMode) {
              document.querySelector('#profile-language').value = result?.profile?.language || '';
              document.querySelector('#profile-nationality').value = code || '';
            } else if (!code) {
              location.replace(`${location.pathname}?mode=profile&type=${type}`);
              return;
            }
          } catch {}
          app.hidden = false;
        } catch (e) {
          error.hidden = false;
        }
      }
      boot();
    </script>
  </body>
</html>

<style is:global>
