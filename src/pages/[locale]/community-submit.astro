---
export function getStaticPaths() {
  return [{ params: { locale: 'ja' } }];
}
import profileOptions from '../../data/profile-options.json';

const { locale = 'ja' } = Astro.params;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <title>Sotocom 投稿</title>
  </head>
  <body>
    <main class="liff-shell" id="liff-app" hidden>
      <header class="liff-header">
        <p class="liff-kicker">SOTOCOM COMMUNITY</p>
        <h1 id="page-title">投稿する</h1>
        <p id="page-intro">LINEから投稿内容を送信できます。確認後に掲載します。</p>
      </header>

      <form id="profile-form" class="profile-form" hidden>
        <div class="profile-field" id="profile-language-field">
          <label for="profile-language">使用する言語 <em aria-label="必須">*</em></label>
          <select id="profile-language" name="languageCode" required>
            <option value="">言語を選択してください</option>
            {profileOptions.languages.filter((language) => ['ja', 'en', 'zh-CN', 'zh-TW', 'ko', 'vi', 'ne', 'tl', 'id', 'pt', 'th'].includes(language.code)).map((language) => <option value={language.code}>{language.name}</option>)}
          </select>
        </div>
        <div class="profile-field" id="profile-nationality-field">
          <label for="profile-nationality">国籍 <em aria-label="必須">*</em></label>
          <select id="profile-nationality" name="nationalityCode" required>
            <option value="">国籍を選択してください</option>
            {profileOptions.countries.map((country) => <option value={country.code}>{country.code.replace(/./g, (char) => String.fromCodePoint(127397 + char.charCodeAt(0)))} {country.name}</option>)}
          </select>
        </div>
        <button type="submit" id="profile-save-button">設定を保存する</button>
        <p class="form-status" id="profile-status" aria-live="polite"></p>
      </form>

      <form id="community-form" novalidate>
        <div id="dynamic-fields"></div>
        <section class="photo-uploader" aria-label="写真">
          <input id="photo-input" class="photo-input" type="file" accept="image/*" multiple />
          <label class="photo-upload-button" for="photo-input"><span aria-hidden="true">＋</span> 写真を追加</label>
          <div id="photo-list" class="photo-list" aria-live="polite"></div>
        </section>
        <fieldset class="identity-card">
          <legend>表示名 <em aria-label="必須">*</em></legend>
          <p class="line-profile-name"><img id="line-profile-avatar" alt="" hidden />LINEの表示名：<strong id="line-display-name">取得中…</strong><span id="line-nationality-flag" aria-label="国籍"></span></p>
          <div class="identity-options">
            <label><input type="radio" name="publishNameMode" value="line" checked /><span>LINEの表示名を公開</span></label>
            <label><input type="radio" name="publishNameMode" value="custom" /><span>別の名前を使う</span></label>
            <label><input type="radio" name="publishNameMode" value="private" /><span>非公開</span></label>
          </div>
          <input id="custom-display-name" name="customDisplayName" type="text" maxlength="30" placeholder="表示したい名前を入力" hidden disabled />
          <div class="avatar-options">
            <p>プロフィール画像</p>
            <label><input type="radio" name="publishAvatarMode" value="line" checked /><span>LINEのプロフィール画像を公開</span></label>
            <label><input type="radio" name="publishAvatarMode" value="private" /><span>非公開</span></label>
            <button type="button" class="avatar-picker-toggle" id="avatar-picker-toggle" aria-expanded="false">用意したアイコンから選ぶ</button>
            <div class="avatar-picker" id="avatar-picker" hidden aria-label="使用するアイコンを選択">
              {Array.from({ length: 10 }, (_, index) => {
                const number = String(index + 1).padStart(2, '0');
                return <button type="button" class="avatar-choice" data-avatar-url={`/images/avatars/avatar-${number}.webp`} aria-label={`アイコン${index + 1}`}><img src={`/images/avatars/avatar-${number}.webp`} alt="" /></button>;
              })}
            </div>
            <input type="hidden" id="selected-avatar-url" name="selectedAvatarUrl" value="" />
          </div>
        </fieldset>
        <label class="agreement"><input name="agreement" type="checkbox" required /><span>投稿内容が確認後に公開されることに同意します。</span></label>
        <button type="submit" id="submit-button">投稿内容を送信する</button>
        <p class="form-status" id="form-status" aria-live="polite"></p>
      </form>
    </main>

    <section class="liff-error" id="liff-error" hidden>
      <p class="liff-kicker">SOTOCOM COMMUNITY</p>
      <h1>LINEから開いてください</h1>
      <p>この投稿フォームは、Sotocom LINE公式アカウントの投稿メニューからのみ利用できます。</p>
    </section>

    <section class="photo-editor" id="photo-editor" hidden aria-modal="true" role="dialog" aria-labelledby="photo-editor-title">
      <header class="photo-editor-header">
        <button type="button" id="photo-editor-cancel">キャンセル</button>
        <h2 id="photo-editor-title">写真を編集</h2>
        <button type="button" id="photo-editor-save">保存</button>
      </header>
      <div class="photo-editor-stage">
        <canvas id="photo-editor-canvas"></canvas>
      </div>
      <div class="photo-editor-tools">
        <div class="photo-editor-tabs" role="group" aria-label="編集ツール">
          <button type="button" class="is-active" data-editor-tool="crop">切り抜き</button>
          <button type="button" data-editor-tool="mosaic">モザイク</button>
        </div>
        <p id="photo-editor-guide">残したい範囲を指で囲んでください。</p>
        <div class="photo-editor-actions">
          <button type="button" id="photo-editor-apply-crop">切り抜く</button>
          <button type="button" id="photo-editor-undo">元に戻す</button>
          <button type="button" id="photo-editor-reset">リセット</button>
        </div>
      </div>
    </section>

    <script>
      const LIFF_ID = '2011054732-exitzB6m';
      const API_URL = 'https://sotocom-api.syouboc.workers.dev/api/submissions';
      const OFFICIAL_ACCOUNT_URL = 'https://line.me/R/ti/p/%40721khrrb';
      const configs = {
        listings: { title: '入居募集を投稿する', intro: '物件カードに必要な情報を順番に入力してください。確認後、掲載用に整えます。', fields: [['listingType', '募集タイプ', '', 'select', [['tenant', 'オーナー直貸し'], ['share', 'ルームシェア募集']]], ['title', '募集タイトル', '例：駅から徒歩5分の1LDK', 'text'], ['prefecture', '都道府県', '', 'select', [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']]], ['area', '区・市町村', '', 'select', []], ['station', '最寄り駅', '例：中野駅 徒歩5分', 'text'], ['rent', '家賃（月額・円）', '例：90000', 'number'], ['managementFee', '管理費（月額・円）', '例：5000', 'number'], ['layout', '間取り・広さ', '', 'select', []], ['moveIn', '入居可能時期', '', 'select', []], ['furnished', '家具・家電', '', 'select', [['あり', '家具・家電付き'], ['一部', '一部あり'], ['なし', 'なし']]], ['details', '条件・補足', '初期費用、契約期間、性別条件、同居人など', 'textarea']] },
        'used-market': { title: '中古市場に投稿する', intro: '中古市場のカードに必要な商品情報を入力してください。写真は後から追加できます。', fields: [['category', 'カテゴリー', '', 'select', [['furniture', '家具'], ['appliance', '家電・ガジェット'], ['daily-goods', '生活雑貨・キッチン'], ['fashion', 'ファッション・美容'], ['kids', '子供用品・おもちゃ'], ['hobby', '本・趣味・スポーツ'], ['other', 'その他']]], ['title', '商品名', '例：冷蔵庫（168L）', 'text'], ['condition', '商品の状態', '', 'select', [['new', '新品・未使用'], ['good', '目立つ傷なし'], ['used', '使用感あり'], ['repair', '要確認・難あり']]], ['price', '価格（円）', '無料の場合は0', 'number'], ['prefecture', '受け渡し都道府県', '', 'select', [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']]], ['pickupArea', '受け渡し場所', '例：中野駅・杉並区', 'text'], ['availableUntil', '受け渡し可能日', '', 'select', []], ['delivery', '受け渡し方法', '', 'select', [['pickup', '現地受け取り'], ['station', '駅で受け渡し'], ['delivery', '配送相談'], ['other', 'その他']]], ['details', '商品説明', '購入時期、サイズ、動作確認、傷、付属品など', 'textarea']] },
        jobs: { title: '求人を投稿する', intro: '求人カードに必要な募集条件を入力してください。応募者が比較しやすい形に整えます。', fields: [['jobCategory', '職種カテゴリー', '', 'select', [['hotel', 'ホテル・宿泊'], ['restaurant', '飲食'], ['cleaning', '清掃'], ['office', '事務・オフィス'], ['care', '介護・福祉'], ['other', 'その他']]], ['title', '募集職種', '例：ホテルフロントスタッフ', 'text'], ['company', '会社・店舗名', '掲載名として表示します', 'text'], ['employmentType', '雇用形態', '', 'select', [['part-time', 'アルバイト・パート'], ['full-time', '正社員'], ['contract', '契約社員'], ['freelance', '業務委託'], ['other', 'その他']]], ['workplace', '勤務地', '', 'select', []], ['salary', '給与・報酬', '例：時給1,300円〜／月給25万円〜', 'text'], ['hours', '勤務時間', '', 'select', []], ['japaneseLevel', '日本語レベル', '', 'select', [['none', '不問'], ['basic', '日常会話'], ['business', 'ビジネスレベル'], ['native', 'ネイティブ相当']]], ['benefits', '待遇・条件', '交通費、まかない、寮、資格、経験など', 'textarea'], ['application', '応募方法', '担当者、連絡先、応募時に伝える内容など', 'textarea']] },
        events: { title: 'イベントを投稿する', intro: 'イベントページに表示する開催情報と参加方法を入力してください。', fields: [['title', 'タイトル', '例：多文化交流会', 'text'], ['startsAt', '開始', '', 'datetime-local'], ['endsAt', '終了', '', 'datetime-local'], ['venue', '場所・住所', '例：東京都渋谷区〇〇／渋谷カフェ', 'text'], ['eventPrefecture', '都道府県', '', 'select'], ['summary', '紹介文', 'イベントの内容や、どんな人におすすめかを書いてください', 'textarea'], ['fee', '参加費', '', 'select'], ['feeAmount', '参加費の金額', '', 'select'], ['capacity', '定員', '', 'select'], ['participationType', '参加方法', '', 'select'], ['applicationUrl', '申込方法・URL', '例：https://example.com または「当日受付」', 'text'], ['notes', '注意事項', '持ち物、対象年齢、雨天時の対応など', 'textarea'], ['other', 'その他', '補足があれば入力してください', 'textarea']] },
        help: { title: '助け合いを投稿する', intro: '助けを求める人と協力できる人が判断しやすい情報を入力してください。', fields: [['category', '依頼カテゴリー', '', 'select', [['translate', '通訳・翻訳'], ['pet', 'ペット・留守番'], ['labor', '力仕事・引越し'], ['other', 'その他']]], ['title', '投稿タイトル', '例：引っ越しを手伝ってくれる方を探しています', 'text'], ['requestDate', '希望日時', '', 'select', []], ['area', '場所', '例：杉並区・高円寺エリア', 'text'], ['reward', '謝礼', '', 'select', []], ['urgent', '急募', '', 'select', [['no', '通常'], ['yes', '急募']]], ['details', '依頼内容', 'いつ、どこで、何を手伝ってほしいかを具体的に書いてください', 'textarea'], ['contact', '連絡方法', 'LINE ID、メール、その他の希望連絡方法', 'text']] }
      };
      const params = new URLSearchParams(location.search);
      const profileMode = params.get('mode') === 'profile';
      const languageMode = params.get('mode') === 'language';
      const type = params.get('type') || 'events';
      const config = configs[type] || configs.events;
      const app = document.querySelector('#liff-app');
      const error = document.querySelector('#liff-error');
      const status = document.querySelector('#form-status');
      const form = document.querySelector('#community-form');
      const profileForm = document.querySelector('#profile-form');
      const profileStatus = document.querySelector('#profile-status');
      const fields = document.querySelector('#dynamic-fields');
      const lineDisplayName = document.querySelector('#line-display-name');
      const lineProfileAvatar = document.querySelector('#line-profile-avatar');
      const lineNationalityFlag = document.querySelector('#line-nationality-flag');
      const customDisplayName = document.querySelector('#custom-display-name');
      const avatarPickerToggle = document.querySelector('#avatar-picker-toggle');
      const avatarPicker = document.querySelector('#avatar-picker');
      const selectedAvatarUrl = document.querySelector('#selected-avatar-url');
      let profileDisplayName = '';
      let shellTouchStartX = 0;
      let shellTouchStartY = 0;
      app.addEventListener('touchstart', (event) => { shellTouchStartX = event.touches[0]?.clientX || 0; shellTouchStartY = event.touches[0]?.clientY || 0; }, { passive: true });
      app.addEventListener('touchmove', (event) => {
        if (event.target.closest('.photo-drag-handle')) return;
        const currentX = event.touches[0]?.clientX || 0;
        const currentY = event.touches[0]?.clientY || 0;
        const deltaX = currentX - shellTouchStartX;
        const deltaY = currentY - shellTouchStartY;
        const isVerticalPull = Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 4;
        const pullingPastTop = isVerticalPull && app.scrollTop <= 0 && deltaY > 0;
        const pullingPastBottom = isVerticalPull && Math.ceil(app.scrollTop + app.clientHeight) >= app.scrollHeight && deltaY < 0;
        if (pullingPastTop || pullingPastBottom) event.preventDefault();
      }, { passive: false });
      document.querySelector('#page-title').textContent = config.title;
      document.querySelector('#page-intro').textContent = config.intro;
      if (profileMode) {
        document.querySelector('#page-title').textContent = '国籍・言語の設定';
        document.querySelector('#page-intro').textContent = '投稿者名の横に表示する国旗と、Sotocomで使用する言語を設定してください。';
        form.hidden = true;
        profileForm.hidden = false;
      }
      if (languageMode) {
        document.querySelector('#page-title').textContent = '言語設定';
        document.querySelector('#page-intro').textContent = '表示する言語を選択してください。国籍は変更できません。';
        document.querySelector('#profile-nationality-field').hidden = true;
        document.querySelector('#profile-nationality').disabled = true;
        form.hidden = true;
        profileForm.hidden = false;
      }
      fields.innerHTML = config.fields.map(([name, label, placeholder, kind]) => {
        const rows = name === 'summary' ? 4 : ['notes', 'other'].includes(name) ? 3 : 4;
        return `<label><span class="field-label">${label}<em aria-label="必須">*</em></span>${kind === 'textarea' ? `<textarea name="${name}" rows="${rows}" placeholder="${placeholder}" required></textarea>` : `<input name="${name}" type="${kind}" placeholder="${placeholder}" required />`}</label>`;
      }).join('');
      if (type === 'listings') {
        const areaInput = fields.querySelector('[name="area"]');
        if (areaInput) {
          areaInput.type = 'text';
          areaInput.placeholder = '例：新宿区・杉並区';
        }
        const stationLabel = fields.querySelector('[name="station"]')?.closest('label');
        if (stationLabel && !fields.querySelector('[name="floorArea"]')) {
          const label = document.createElement('label');
          label.innerHTML = '<span class="field-label">面積（㎡）<em aria-label="必須">*</em></span><input name="floorArea" type="text" placeholder="例：40㎡" required />';
          stationLabel.after(label);
        }
        const floorAreaLabel = fields.querySelector('[name="floorArea"]')?.closest('label');
        if (floorAreaLabel && !fields.querySelector('[name="contact"]')) {
          const label = document.createElement('label');
          label.innerHTML = '<span class="field-label">連絡方法<em aria-label="必須">*</em></span><input name="contact" type="text" placeholder="例：LINE ID／メールアドレス" required />';
          floorAreaLabel.after(label);
        }
      }
      if (type === 'events') {
        ['applicationUrl', 'notes', 'other'].forEach((name) => {
          const control = fields.querySelector(`[name="${name}"]`);
          control.required = false;
          control.closest('label').querySelector('em').remove();
        });
        const startsAt = fields.querySelector('[name="startsAt"]');
        const endsAt = fields.querySelector('[name="endsAt"]');
        const validateEventPeriod = () => {
          endsAt.setCustomValidity(startsAt.value && endsAt.value && endsAt.value <= startsAt.value ? '終了は開始より後の日時を選択してください。' : '');
        };
        startsAt.addEventListener('change', validateEventPeriod);
        endsAt.addEventListener('change', validateEventPeriod);
      }
      form.querySelectorAll('[name="publishNameMode"]').forEach((radio) => radio.addEventListener('change', () => {
        const useCustomName = radio.checked && radio.value === 'custom';
        if (!radio.checked) return;
        customDisplayName.hidden = !useCustomName;
        customDisplayName.disabled = !useCustomName;
        customDisplayName.required = useCustomName;
        if (useCustomName) customDisplayName.focus();
      }));
      form.querySelectorAll('[name="publishAvatarMode"]').forEach((radio) => radio.addEventListener('change', () => {
        if (radio.checked && radio.value === 'line') {
          selectedAvatarUrl.value = '';
          form.querySelectorAll('.avatar-choice').forEach((choice) => choice.classList.remove('is-selected'));
        }
      }));
      avatarPickerToggle.addEventListener('click', () => {
        const willOpen = avatarPicker.hidden;
        avatarPicker.hidden = !willOpen;
        avatarPickerToggle.setAttribute('aria-expanded', String(willOpen));
      });
      form.querySelectorAll('.avatar-choice').forEach((choice) => choice.addEventListener('click', () => {
        selectedAvatarUrl.value = choice.dataset.avatarUrl || '';
        choice.closest('.avatar-picker').querySelectorAll('.avatar-choice').forEach((item) => item.classList.remove('is-selected'));
        choice.classList.add('is-selected');
        form.querySelector('[name="publishAvatarMode"][value="private"]').checked = true;
      }));
      function getPublishDisplayName() {
        const mode = form.elements.publishNameMode.value;
        if (mode === 'private') return '非公開';
        if (mode === 'custom') return customDisplayName.value.trim();
        return profileDisplayName || 'LINEユーザー';
      }

      const photoInput = document.querySelector('#photo-input');
      const photoList = document.querySelector('#photo-list');
      const photoFiles = [];
      let draggedPhotoItem = null;
      let pressedPhotoItem = null;
      let photoDragGhost = null;
      let photoDragPointerId = null;
      let photoDragStartX = 0;
      let photoDragStartY = 0;
      function renderPhotos() { photoList.innerHTML = photoFiles.map((file, index) => `<article class="photo-item" data-photo-index="${index}"><img src="${URL.createObjectURL(file)}" alt="選択した写真 ${index + 1}" draggable="false"><span class="photo-main-badge" ${index === 0 ? '' : 'hidden'}>主画像</span><button class="photo-remove" type="button" data-photo-remove="${index}" aria-label="写真を削除">×</button></article>`).join(''); }
      function syncPhotoRows() {
        Array.from(photoList.querySelectorAll('.photo-item')).forEach((item, index) => {
          item.dataset.photoIndex = String(index);
          item.querySelector('img').alt = `選択した写真 ${index + 1}`;
          item.querySelector('.photo-main-badge').hidden = index !== 0;
          item.querySelector('[data-photo-remove]').dataset.photoRemove = String(index);
        });
      }
      photoInput.addEventListener('change', () => { const incoming = Array.from(photoInput.files || []).filter((file) => file.type.startsWith('image/')); photoFiles.push(...incoming.slice(0, Math.max(0, 8 - photoFiles.length))); photoInput.value = ''; renderPhotos(); });
      photoList.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-photo-remove]');
        if (button) { const item = button.closest('.photo-item'); photoFiles.splice(Number(button.dataset.photoRemove), 1); URL.revokeObjectURL(item.querySelector('img').src); item.remove(); syncPhotoRows(); return; }
      });
      photoList.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button') || event.button !== 0) return;
        const item = event.target.closest('.photo-item');
        if (!item) return;
        event.preventDefault();
        pressedPhotoItem = item;
        photoDragPointerId = event.pointerId;
        pressedPhotoItem.classList.add('is-pressing');
        photoDragStartX = event.clientX;
        photoDragStartY = event.clientY;
        try { pressedPhotoItem.setPointerCapture(photoDragPointerId); } catch {}
      });
      document.addEventListener('pointermove', (event) => {
        if (!pressedPhotoItem || event.pointerId !== photoDragPointerId) return;
        const moved = Math.hypot(event.clientX - photoDragStartX, event.clientY - photoDragStartY);
        if (!draggedPhotoItem && moved < 6) return;
        event.preventDefault();
        if (!draggedPhotoItem) {
          if (photoFiles.length < 2) return;
          draggedPhotoItem = pressedPhotoItem;
          const rect = draggedPhotoItem.getBoundingClientRect();
          photoDragGhost = draggedPhotoItem.cloneNode(true);
          photoDragGhost.classList.remove('photo-item', 'is-pressing');
          photoDragGhost.classList.add('photo-drag-ghost');
          Object.assign(photoDragGhost.style, { left: `${rect.left}px`, top: `${rect.top}px`, width: `${rect.width}px`, height: `${rect.height}px` });
          document.body.appendChild(photoDragGhost);
          draggedPhotoItem.classList.remove('is-pressing');
          draggedPhotoItem.classList.add('is-drag-source');
          photoList.classList.add('is-sorting');
          navigator.vibrate?.(22);
        }
        photoDragGhost.style.transform = `translate3d(${event.clientX - photoDragStartX}px, ${event.clientY - photoDragStartY}px, 0) scale(1.025)`;
        const listRect = photoList.getBoundingClientRect();
        const gap = Number.parseFloat(getComputedStyle(photoList).columnGap) || 8;
        const cellSize = (listRect.width - gap * 3) / 4;
        const column = Math.max(0, Math.min(3, Math.floor((event.clientX - listRect.left) / (cellSize + gap))));
        const row = Math.max(0, Math.floor((event.clientY - listRect.top) / (cellSize + gap)));
        const desiredIndex = Math.min(photoFiles.length - 1, row * 4 + column);
        const siblings = Array.from(photoList.querySelectorAll('.photo-item:not(.is-drag-source)'));
        const nextItem = siblings[desiredIndex] || null;
        const isSamePosition = nextItem ? draggedPhotoItem.nextElementSibling === nextItem : draggedPhotoItem === photoList.lastElementChild;
        if (isSamePosition) return;
        const previousPositions = new Map(siblings.map((item) => { const rect = item.getBoundingClientRect(); return [item, { left: rect.left, top: rect.top }]; }));
        if (nextItem) photoList.insertBefore(draggedPhotoItem, nextItem); else photoList.appendChild(draggedPhotoItem);
        siblings.forEach((item) => {
          const current = item.getBoundingClientRect();
          const previous = previousPositions.get(item);
          const offsetX = previous.left - current.left;
          const offsetY = previous.top - current.top;
          if (offsetX || offsetY) item.animate?.([{ transform: `translate(${offsetX}px, ${offsetY}px)` }, { transform: 'translate(0, 0)' }], { duration: 160, easing: 'cubic-bezier(.2,.8,.2,1)' });
        });
      }, { passive: false });
      function finishPhotoDrag(event) {
        if (!pressedPhotoItem || event.pointerId !== photoDragPointerId) return;
        const tappedItem = pressedPhotoItem;
        const wasDragging = Boolean(draggedPhotoItem);
        try { pressedPhotoItem.releasePointerCapture(photoDragPointerId); } catch {}
        if (wasDragging) {
          const reordered = Array.from(photoList.querySelectorAll('.photo-item')).map((item) => photoFiles[Number(item.dataset.photoIndex)]);
          photoFiles.splice(0, photoFiles.length, ...reordered);
          draggedPhotoItem.classList.remove('is-drag-source');
          photoList.classList.remove('is-sorting');
          photoDragGhost?.remove();
          navigator.vibrate?.(10);
          syncPhotoRows();
        }
        tappedItem.classList.remove('is-pressing');
        draggedPhotoItem = null;
        pressedPhotoItem = null;
        photoDragGhost = null;
        photoDragPointerId = null;
        if (!wasDragging && event.type !== 'pointercancel') openPhotoEditor(Number(tappedItem.dataset.photoIndex));
      }
      document.addEventListener('pointerup', finishPhotoDrag);
      document.addEventListener('pointercancel', finishPhotoDrag);
      photoList.addEventListener('contextmenu', (event) => { if (event.target.closest('.photo-item')) event.preventDefault(); });
      photoList.addEventListener('selectstart', (event) => event.preventDefault());
      photoList.addEventListener('dragstart', (event) => event.preventDefault());

      const photoEditor = document.querySelector('#photo-editor');
      const editorCanvas = document.querySelector('#photo-editor-canvas');
      const editorGuide = document.querySelector('#photo-editor-guide');
      const editorApplyCrop = document.querySelector('#photo-editor-apply-crop');
      const editorUndo = document.querySelector('#photo-editor-undo');
      let editorWorkCanvas = document.createElement('canvas');
      let editorOriginalCanvas = document.createElement('canvas');
      let editorPhotoIndex = -1;
      let editorTool = 'crop';
      let editorIsDrawing = false;
      let editorCropSelection = null;
      let editorPointerStart = null;
      let editorHistory = [];

      function copyCanvas(source) {
        const copy = document.createElement('canvas');
        copy.width = source.width;
        copy.height = source.height;
        copy.getContext('2d').drawImage(source, 0, 0);
        return copy;
      }

      function pushEditorHistory() {
        editorHistory.push(copyCanvas(editorWorkCanvas));
        if (editorHistory.length > 6) editorHistory.shift();
        editorUndo.disabled = editorHistory.length === 0;
      }

      function drawEditor() {
        editorCanvas.width = editorWorkCanvas.width;
        editorCanvas.height = editorWorkCanvas.height;
        const context = editorCanvas.getContext('2d');
        context.clearRect(0, 0, editorCanvas.width, editorCanvas.height);
        context.drawImage(editorWorkCanvas, 0, 0);
        if (editorTool === 'crop' && editorCropSelection) {
          const { x, y, width, height } = editorCropSelection;
          context.fillStyle = '#08131ab8';
          context.fillRect(0, 0, editorCanvas.width, editorCanvas.height);
          context.drawImage(editorWorkCanvas, x, y, width, height, x, y, width, height);
          context.strokeStyle = '#b8d86a';
          context.lineWidth = Math.max(3, editorCanvas.width / 350);
          context.setLineDash([Math.max(8, editorCanvas.width / 120), Math.max(5, editorCanvas.width / 180)]);
          context.strokeRect(x, y, width, height);
        }
        editorUndo.disabled = editorHistory.length === 0;
      }

      function editorPoint(event) {
        const rect = editorCanvas.getBoundingClientRect();
        return {
          x: Math.max(0, Math.min(editorCanvas.width, (event.clientX - rect.left) * editorCanvas.width / rect.width)),
          y: Math.max(0, Math.min(editorCanvas.height, (event.clientY - rect.top) * editorCanvas.height / rect.height))
        };
      }

      async function loadEditorImage(file) {
        const url = URL.createObjectURL(file);
        try {
          const image = await new Promise((resolve, reject) => { const element = new Image(); element.onload = () => resolve(element); element.onerror = reject; element.src = url; });
          const scale = Math.min(1, 1600 / Math.max(image.naturalWidth, image.naturalHeight));
          editorWorkCanvas = document.createElement('canvas');
          editorWorkCanvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
          editorWorkCanvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
          editorWorkCanvas.getContext('2d').drawImage(image, 0, 0, editorWorkCanvas.width, editorWorkCanvas.height);
          editorOriginalCanvas = copyCanvas(editorWorkCanvas);
        } finally { URL.revokeObjectURL(url); }
      }

      function setEditorTool(tool) {
        editorTool = tool;
        editorCropSelection = null;
        document.querySelectorAll('[data-editor-tool]').forEach((button) => button.classList.toggle('is-active', button.dataset.editorTool === tool));
        editorGuide.textContent = tool === 'crop' ? '残したい範囲を指で囲んでください。' : '隠したい部分を指でなぞってください。';
        editorApplyCrop.hidden = tool !== 'crop';
        drawEditor();
      }

      async function openPhotoEditor(index) {
        if (!photoFiles[index]) return;
        editorPhotoIndex = index;
        editorHistory = [];
        editorCropSelection = null;
        await loadEditorImage(photoFiles[index]);
        photoEditor.hidden = false;
        app.setAttribute('aria-hidden', 'true');
        setEditorTool('crop');
      }

      function closePhotoEditor() {
        photoEditor.hidden = true;
        app.removeAttribute('aria-hidden');
        editorPhotoIndex = -1;
        editorHistory = [];
        editorCropSelection = null;
      }

      function applyEditorCrop() {
        if (!editorCropSelection || editorCropSelection.width < 20 || editorCropSelection.height < 20) return false;
        pushEditorHistory();
        const { x, y, width, height } = editorCropSelection;
        const cropped = document.createElement('canvas');
        cropped.width = Math.round(width);
        cropped.height = Math.round(height);
        cropped.getContext('2d').drawImage(editorWorkCanvas, x, y, width, height, 0, 0, cropped.width, cropped.height);
        editorWorkCanvas = cropped;
        editorCropSelection = null;
        drawEditor();
        return true;
      }

      function applyMosaic(point) {
        const context = editorWorkCanvas.getContext('2d', { willReadFrequently: true });
        const displayWidth = Math.max(1, editorCanvas.getBoundingClientRect().width);
        const displayScale = editorWorkCanvas.width / displayWidth;
        const block = Math.max(10, Math.round(9 * displayScale));
        const radius = Math.max(block * 2, Math.round(28 * displayScale));
        for (let y = point.y - radius; y <= point.y + radius; y += block) {
          for (let x = point.x - radius; x <= point.x + radius; x += block) {
            if ((x - point.x) ** 2 + (y - point.y) ** 2 > radius ** 2) continue;
            const sampleX = Math.max(0, Math.min(editorWorkCanvas.width - 1, Math.round(x + block / 2)));
            const sampleY = Math.max(0, Math.min(editorWorkCanvas.height - 1, Math.round(y + block / 2)));
            const color = context.getImageData(sampleX, sampleY, 1, 1).data;
            context.fillStyle = `rgb(${color[0]} ${color[1]} ${color[2]})`;
            context.fillRect(Math.round(x), Math.round(y), block + 1, block + 1);
          }
        }
        drawEditor();
      }

      editorCanvas.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        editorCanvas.setPointerCapture(event.pointerId);
        editorIsDrawing = true;
        editorPointerStart = editorPoint(event);
        if (editorTool === 'mosaic') { pushEditorHistory(); applyMosaic(editorPointerStart); }
      });
      editorCanvas.addEventListener('pointermove', (event) => {
        if (!editorIsDrawing) return;
        event.preventDefault();
        const point = editorPoint(event);
        if (editorTool === 'mosaic') { applyMosaic(point); return; }
        editorCropSelection = { x: Math.min(editorPointerStart.x, point.x), y: Math.min(editorPointerStart.y, point.y), width: Math.abs(point.x - editorPointerStart.x), height: Math.abs(point.y - editorPointerStart.y) };
        drawEditor();
      });
      function finishEditorPointer(event) { if (!editorIsDrawing) return; editorIsDrawing = false; try { editorCanvas.releasePointerCapture(event.pointerId); } catch {} }
      editorCanvas.addEventListener('pointerup', finishEditorPointer);
      editorCanvas.addEventListener('pointercancel', finishEditorPointer);
      document.querySelectorAll('[data-editor-tool]').forEach((button) => button.addEventListener('click', () => setEditorTool(button.dataset.editorTool)));
      editorApplyCrop.addEventListener('click', applyEditorCrop);
      editorUndo.addEventListener('click', () => { const previous = editorHistory.pop(); if (!previous) return; editorWorkCanvas = previous; editorCropSelection = null; drawEditor(); });
      document.querySelector('#photo-editor-reset').addEventListener('click', () => { pushEditorHistory(); editorWorkCanvas = copyCanvas(editorOriginalCanvas); editorCropSelection = null; drawEditor(); });
      document.querySelector('#photo-editor-cancel').addEventListener('click', closePhotoEditor);
      document.querySelector('#photo-editor-save').addEventListener('click', async (event) => {
        if (editorTool === 'crop' && editorCropSelection) applyEditorCrop();
        const saveButton = event.currentTarget;
        saveButton.disabled = true;
        try {
          const oldFile = photoFiles[editorPhotoIndex];
          const outputType = oldFile.type === 'image/png' ? 'image/png' : 'image/jpeg';
          const blob = await new Promise((resolve) => editorWorkCanvas.toBlob(resolve, outputType, .9));
          if (!blob) throw new Error('image-export-failed');
          const extension = outputType === 'image/png' ? 'png' : 'jpg';
          const editedFile = new File([blob], `${oldFile.name.replace(/\.[^.]+$/, '')}-edited.${extension}`, { type: outputType, lastModified: Date.now() });
          photoFiles[editorPhotoIndex] = editedFile;
          const item = photoList.querySelector(`.photo-item[data-photo-index="${editorPhotoIndex}"]`);
          const image = item?.querySelector('img');
          if (image) { URL.revokeObjectURL(image.src); image.src = URL.createObjectURL(editedFile); }
          closePhotoEditor();
        } catch {
          editorGuide.textContent = '保存できませんでした。もう一度お試しください。';
        } finally { saveButton.disabled = false; }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        event.stopImmediatePropagation();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const liff = await loadLiff;
        const idToken = liff.getIDToken();
        if (!idToken) { status.textContent = 'LINE認証を確認できませんでした。'; status.classList.add('visible'); return; }
        status.textContent = '写真と投稿内容を送信中…'; status.classList.add('visible');
        const values = Object.fromEntries(new FormData(form).entries());
        delete values.agreement; delete values.publishNameMode; delete values.customDisplayName; delete values.photos;
        const upload = new FormData();
        upload.append('submission', JSON.stringify({ type, displayName: getPublishDisplayName(), publishNameMode: form.elements.publishNameMode.value, publishAvatarMode: form.elements.publishAvatarMode.value, avatarUrl: selectedAvatarUrl.value, payload: values }));
        photoFiles.forEach((file) => upload.append('photos', file, file.name));
        try {
          const response = await fetch(API_URL, { method: 'POST', headers: { authorization: `Bearer ${idToken}` }, body: upload });
          if (!response.ok) throw new Error('submission-failed');
          status.textContent = '投稿を受け付けました。写真を含めて確認後に掲載します。'; form.reset(); customDisplayName.hidden = true; customDisplayName.disabled = true; photoFiles.length = 0; renderPhotos();
        } catch { status.textContent = '送信に失敗しました。時間を置いて再度お試しください。'; }
      }, true);

      const selectOptions = {
        listingType: [['tenant', 'オーナー直貸し'], ['share', 'ルームシェア募集']],
        prefecture: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['その他', 'その他']],
        area: type === 'listings' ? [['新宿区', '新宿区'], ['渋谷区', '渋谷区'], ['中野区', '中野区'], ['杉並区', '杉並区'], ['世田谷区', '世田谷区'], ['豊島区', '豊島区'], ['港区', '港区'], ['台東区', '台東区'], ['その他', 'その他']] : [],
        layout: [['1R', '1R'], ['1K', '1K'], ['1DK', '1DK'], ['1LDK', '1LDK'], ['2DK', '2DK'], ['2LDK', '2LDK'], ['3LDK以上', '3LDK以上'], ['その他', 'その他']],
        moveIn: [['immediate', '即入居可'], ['next-month', '翌月から'], ['相談', '時期相談'], ['other', 'その他']],
        furnished: [['あり', '家具・家電付き'], ['一部', '一部あり'], ['なし', 'なし']],
        category: type === 'help' ? [['translate', '通訳・翻訳'], ['pet', 'ペット・留守番'], ['labor', '力仕事・引越し'], ['other', 'その他']] : [['furniture', '家具'], ['appliance', '家電・ガジェット'], ['daily-goods', '生活雑貨・キッチン'], ['fashion', 'ファッション・美容'], ['kids', '子供用品・おもちゃ'], ['hobby', '本・趣味・スポーツ'], ['other', 'その他']],
        condition: [['new', '新品・未使用'], ['good', '目立つ傷なし'], ['used', '使用感あり'], ['repair', '要確認・難あり']],
        delivery: [['pickup', '現地受け取り'], ['station', '駅で受け渡し'], ['delivery', '配送相談'], ['other', 'その他']],
        availableUntil: [['anytime', '日程相談可'], ['this-week', '今週中'], ['this-month', '今月中'], ['date', '指定日まで'], ['other', 'その他']],
        jobCategory: [['hotel', 'ホテル・宿泊'], ['restaurant', '飲食'], ['cleaning', '清掃'], ['office', '事務・オフィス'], ['care', '介護・福祉'], ['other', 'その他']],
        employmentType: [['part-time', 'アルバイト・パート'], ['full-time', '正社員'], ['contract', '契約社員'], ['freelance', '業務委託'], ['other', 'その他']],
        workplace: [['東京都', '東京都'], ['神奈川県', '神奈川県'], ['埼玉県', '埼玉県'], ['千葉県', '千葉県'], ['群馬県', '群馬県'], ['その他', 'その他']],
        hours: [['day', '日中（9:00〜18:00前後）'], ['morning', '早朝・午前'], ['evening', '夕方・夜'], ['shift', 'シフト制'], ['flexible', '応相談']],
        japaneseLevel: [['none', '不問'], ['basic', '日常会話'], ['business', 'ビジネスレベル'], ['native', 'ネイティブ相当']],
        eventPrefecture: ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'].map((name) => [name, name]),
        fee: [['free', '無料'], ['paid', '有料']],
        feeAmount: [['500', '500円'], ['1000', '1,000円'], ['1500', '1,500円'], ['2000', '2,000円'], ['3000', '3,000円'], ['5000', '5,000円'], ['10000', '10,000円'], ['other', 'その他（「その他」に記入）']],
        capacity: [['small', '10名未満'], ['medium', '10〜30名'], ['large', '30名以上'], ['unlimited', '定員なし'], ['unknown', '未定']],
        participationType: [['reservation', '事前予約'], ['walk-in', '当日参加'], ['both', '予約・当日参加'], ['contact', '主催者へ問い合わせ']],
        requestDate: [['today', 'できるだけ早く'], ['this-week', '今週中'], ['this-month', '今月中'], ['flexible', '日程相談可'], ['other', '指定日あり']],
        reward: [['paid', '謝礼あり'], ['consult', '応相談'], ['none', '無償'], ['exchange', '物品・サービス交換']],
        urgent: [['no', '通常'], ['yes', '急募']],
      };
      Object.entries(selectOptions).forEach(([name, options]) => { if (type === 'listings' && name === 'area') return; const old = fields.querySelector(`[name="${name}"]`); if (!old || !options.length) return; const select = document.createElement('select'); select.name = name; select.required = true; select.innerHTML = `<option value="">選択してください</option>${options.map(([value, text]) => `<option value="${value}">${text}</option>`).join('')}`; old.replaceWith(select); });
      const feeSelect = fields.querySelector('[name="fee"]');
      const feeAmountSelect = fields.querySelector('[name="feeAmount"]');
      const feeAmountField = feeAmountSelect?.closest('label');
      function syncFeeAmount() {
        if (!feeAmountSelect || !feeAmountField) return;
        const isPaid = feeSelect?.value === 'paid';
        feeAmountField.hidden = !isPaid;
        feeAmountSelect.disabled = !isPaid;
        feeAmountSelect.required = isPaid;
        if (!isPaid) feeAmountSelect.value = '';
      }
      feeSelect?.addEventListener('change', syncFeeAmount);
      syncFeeAmount();

