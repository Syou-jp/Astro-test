---
import fs from "node:fs/promises";
import path from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import pages from "../../data/ja-pages.json";
import { DEFAULT_LOCALE, ENABLED_LOCALES } from "../../data/locales";

export async function getStaticPaths() {
  return ENABLED_LOCALES.flatMap((locale) =>
    pages.map((page) => ({
      params: { locale: locale.code, slug: page.slug },
      props: { locale: locale.code, page }
    }))
  );
}

const { locale, page } = Astro.props;
const contentRoot = path.join(process.cwd(), "src", "content");
const localizedContent = path.join(contentRoot, locale, `${page.slug}.html`);
const fallbackContent = path.join(contentRoot, DEFAULT_LOCALE, `${page.slug}.html`);

let content = "";
try {
  content = await fs.readFile(localizedContent, "utf8");
} catch {
  content = await fs.readFile(fallbackContent, "utf8");
}

// route.html's nearby-station/campus/school finder needs the shared station
// dataset. Kept out of the content file and only loaded on the page that
// uses it so other pages don't pay for the ~550KB blob.
let routeData = "";
if (page.slug === "route") {
  routeData = await fs.readFile(path.join(process.cwd(), "src", "partials", "route-data.json"), "utf8");
}

// news.html renders its digest list/article client-side; the digests
// themselves live as individual markdown files in src/content/news-digests
// so each day's entry can be authored/edited independently.
let newsDigestsData = "";
if (page.slug === "news" || page.slug === "home") {
  const entries = await getCollection("newsDigests");
  const digests = entries
    .map((entry) => ({ id: entry.id, ...entry.data }))
    .sort((a, b) => b.id.localeCompare(a.id));
  newsDigestsData = JSON.stringify(digests);
}

// restaurant-list.html renders its list/detail view client-side; each
// restaurant lives as its own markdown file in src/data/restaurants so
// entries can be authored/edited independently.
let restaurantsData = "";
if (page.slug === "restaurant-list") {
  const entries = await getCollection("restaurants");
  const restaurants = entries
    .map((entry) => ({ id: entry.id, ...entry.data }))
    .sort((a, b) => a.id.localeCompare(b.id));
  restaurantsData = JSON.stringify(restaurants);
}
---
<BaseLayout
  title={page.slug === "home" ? "外's Net｜日本で暮らす外国人のための生活ガイド" : `外's Net | ${page.title ?? page.slug}`}
  activeId={page.id}
  locale={locale}
  slug={page.slug}
>
  {routeData && <script id="routeLocationData" type="application/json" set:html={routeData} />}
  {newsDigestsData && <script id="newsDigestsData" type="application/json" set:html={newsDigestsData} />}
  {restaurantsData && <script id="restaurantsData" type="application/json" set:html={restaurantsData} />}
  <Fragment set:html={content} />
</BaseLayout>

