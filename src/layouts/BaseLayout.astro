---
import "../styles/global.css";
import navGroups from "../data/ja-nav.json";
import { DEFAULT_LOCALE, ENABLED_LOCALES, LOCALES, getLocale, localePath } from "../data/locales";

const { title = "外's Net", activeId = "", locale = DEFAULT_LOCALE, slug = "rent" } = Astro.props;
const currentLocale = getLocale(locale);
const canonicalUrl = new URL(localePath(currentLocale.code, slug), Astro.site ?? Astro.url.origin);
const alternateUrls = ENABLED_LOCALES.map((alternateLocale) => ({
  ...alternateLocale,
  href: new URL(localePath(alternateLocale.code, slug), Astro.site ?? Astro.url.origin).href
}));
---
<!DOCTYPE html>
<html lang={currentLocale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("site-theme");
          if (saved && saved !== "paper") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content="日本で暮らす外国人のための生活・不動産・交通・税金ツール集" />
    <link rel="canonical" href={canonicalUrl.href} />
    {alternateUrls.map((alternate) => (
      <link rel="alternate" hreflang={alternate.htmlLang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, slug), Astro.site ?? Astro.url.origin).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      <div class="masthead">
        <h1><a href={localePath(currentLocale.code)} class="site-title-link">外's Net</a> <span class="site-tagline" id="siteTagline" style="font-size:13px;color:var(--ink-soft);font-weight:400;">日本で暮らす外国人をつなぐ</span></h1>
        <div class="masthead-right">
          <a class:list={["about-nav-btn", activeId === "page-about" && "active"]} id="aboutNavBtn" href={localePath(currentLocale.code, "about")} data-no-i18n><span id="aboutNavLabel">サイトについて</span></a>
          <div class="site-theme-control">
            <label for="themeSwitcher">配色</label>
            <select id="themeSwitcher" aria-label="配色テーマ" data-no-i18n>
              <option value="paper">ベージュ</option>
              <option value="light">淺色</option>
              <option value="dark">深色</option>
              <option value="pink">粉紅色</option>
            </select>
          </div>
          <div class="site-language-control">
            <label for="localeSwitcher">言語</label>
            <select id="localeSwitcher" aria-label="表示言語" data-no-i18n data-current-slug={slug}>
              {LOCALES.map((option) => (
                <option value={option.code} selected={option.code === currentLocale.code} disabled={!option.enabled}>{option.label}</option>
              ))}
            </select>
            <select id="siteLanguage" aria-label="Legacy language state" data-no-i18n hidden>
              <option value="ja" selected={currentLocale.code === "ja"}>日本語</option>
              <option value="zh-TW" selected={currentLocale.code === "zh-tw"}>繁體中文</option>
              <option value="zh-CN" selected={currentLocale.code === "zh-cn"}>简体中文</option>
              <option value="en" selected={currentLocale.code === "en"}>English</option>
              <option value="ko" selected={currentLocale.code === "ko"}>한국어</option>
              <option value="vi" selected={currentLocale.code === "vi"}>Tiếng Việt</option>
            </select>
          </div>
        </div>
      </div>

      <nav class="tab-bar" id="tabBar" aria-label="ページ一覧">
        {navGroups.map((group, i) => (
          <>
            <input type="radio" name="nav-cat" id={`navcat-${i}`} class="tab-group-radio" checked={group.tabs.some((tab) => activeId === tab.id)} />
            <label for={`navcat-${i}`} class:list={["tab-group-label", group.tabs.some((tab) => activeId === tab.id) && "has-active"]}>{group.label}</label>
          </>
        ))}
        {navGroups.map((group, i) => (
          <div class="tab-group-tabs" id={`navcat-${i}-panel`}>
            {group.tabs.map((tab) => (
              <a class:list={["doc-tab", activeId === tab.id && "active"]} href={localePath(currentLocale.code, tab.slug)}>
                <span class="tab-glyph">{tab.glyph}</span>
                <span class="tab-text">{tab.text}<small>{tab.small}</small></span>
              </a>
            ))}
          </div>
        ))}
      </nav>
      <script is:inline>
        (() => {
          if (window.matchMedia("(max-width:640px)").matches) {
            document.querySelectorAll(".tab-group-radio").forEach((radio) => {
              radio.checked = false;
            });
          }
        })();
      </script>

      <main class="tab-panel">
        <slot />
      </main>

      <button type="button" id="backToTop" class="back-to-top" aria-label="ページ上部へ戻る">↑</button>
    </div>

    <script is:inline>
      (() => {
        const mq = window.matchMedia("(max-width:640px)");

        function setup() {
          document.querySelectorAll(".card").forEach((card) => {
            if (card.dataset.collapseReady) return;
            if (card.hasAttribute("data-no-collapse")) return;
            const title = card.querySelector(":scope > .section-title");
            if (!title) return;
            card.dataset.collapseReady = "1";
            title.classList.add("card-toggle");
            const body = document.createElement("div");
            body.className = "card-body";
            let node = title.nextSibling;
            while (node) {
              const next = node.nextSibling;
              body.appendChild(node);
              node = next;
            }
            card.appendChild(body);
            title.addEventListener("click", () => {
              if (!mq.matches) return;
              card.classList.toggle("is-collapsed");
            });
          });
        }

        setup();
        mq.addEventListener("change", () => {
          if (!mq.matches) {
            document.querySelectorAll(".card.is-collapsed").forEach((card) => card.classList.remove("is-collapsed"));
          }
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const select = document.getElementById("themeSwitcher");
        if (!select) return;
        let saved = "paper";
        try {
          saved = localStorage.getItem("site-theme") || "paper";
        } catch (e) {}
        select.value = saved;
        select.addEventListener("change", () => {
          const value = select.value;
          if (value === "paper") {
            document.documentElement.removeAttribute("data-theme");
          } else {
            document.documentElement.setAttribute("data-theme", value);
          }
          try {
            localStorage.setItem("site-theme", value);
          } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const btn = document.getElementById("backToTop");
        if (!btn) return;
        const toggle = () => btn.classList.toggle("is-visible", window.scrollY > 400);
        window.addEventListener("scroll", toggle, { passive: true });
        toggle();
        btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      })();
    </script>
    <script is:inline>
      document.getElementById("localeSwitcher")?.addEventListener("change", (event) => {
        const select = event.currentTarget;
        const slug = select.dataset.currentSlug || "rent";
        window.location.href = `/${select.value}/${slug}/`;
      });
    </script>
    <script is:inline>
      (() => {
        const originalGetElementById = Document.prototype.getElementById;
        const noop = () => {};
        const missingSelectOption = { textContent: "", value: "", dataset: {}, disabled: false, hidden: false };
        const missingElement = new Proxy(
          {
            addEventListener: noop,
            removeEventListener: noop,
            appendChild: noop,
            append: noop,
            prepend: noop,
            remove: noop,
            close: noop,
            showModal: noop,
            focus: noop,
            select: noop,
            setAttribute: noop,
            getAttribute: () => "",
            querySelector: () => missingElement,
            querySelectorAll: () => [],
            closest: () => null,
            classList: { add: noop, remove: noop, toggle: noop, contains: () => false },
            style: {},
            dataset: {},
            options: [],
            selectedOptions: [missingSelectOption],
            value: "",
            checked: false,
            textContent: "",
            innerHTML: "",
            innerText: "",
            disabled: false,
            hidden: false
          },
          {
            get(target, prop) {
              if (prop in target) return target[prop];
              return "";
            },
            set(target, prop, value) {
              target[prop] = value;
              return true;
            }
          }
        );

        Document.prototype.getElementById = function patchedGetElementById(id) {
          return originalGetElementById.call(this, id) || missingElement;
        };
      })();
    </script>
  </body>
</html>
